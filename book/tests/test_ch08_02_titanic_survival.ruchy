// Test File for Chapter 8.2: Titanic Survival Analysis
// EXTREME TDD: RED phase - Write tests FIRST
// These tests will guide the chapter rewrite

// Test helper: Check if two values are approximately equal
fun approx_eq(a, b, tolerance) {
    let diff = if a > b { a - b } else { b - a };
    diff < tolerance
}

// Titanic dataset for testing (sample of 9 passengers)
let passengers = [
    {id: 1, survived: 1, pclass: 1, sex: "female", age: 38, fare: 71.28},
    {id: 4, survived: 1, pclass: 1, sex: "female", age: 35, fare: 53.10},
    {id: 7, survived: 0, pclass: 1, sex: "male", age: 54, fare: 51.86},
    {id: 10, survived: 1, pclass: 2, sex: "female", age: 14, fare: 30.07},
    {id: 12, survived: 1, pclass: 2, sex: "female", age: 58, fare: 26.55},
    {id: 16, survived: 0, pclass: 2, sex: "female", age: 55, fare: 16.00},
    {id: 3, survived: 1, pclass: 3, sex: "female", age: 26, fare: 7.92},
    {id: 5, survived: 0, pclass: 3, sex: "male", age: 35, fare: 8.05},
    {id: 8, survived: 0, pclass: 3, sex: "male", age: 2, fare: 21.08}
];

// TEST 1: Overall Survival Statistics
fun test_overall_survival() {
    let mut survivors = 0;
    let mut casualties = 0;

    for p in passengers {
        if p.survived == 1 {
            survivors = survivors + 1;
        } else {
            casualties = casualties + 1;
        }
    }

    let total = passengers.len();
    let survival_rate = (survivors * 100) / total;

    // Assertions
    assert(total == 9, "Should have 9 passengers");
    assert(survivors == 5, "Should have 5 survivors");
    assert(casualties == 4, "Should have 4 casualties");
    assert(survival_rate == 55, "Survival rate should be ~55%");

    println("✅ test_overall_survival PASSED");
}

// TEST 2: Gender Analysis - Women vs Men survival
fun test_gender_survival() {
    let mut female_total = 0;
    let mut female_survivors = 0;
    let mut male_total = 0;
    let mut male_survivors = 0;

    for p in passengers {
        if p.sex == "female" {
            female_total = female_total + 1;
            if p.survived == 1 {
                female_survivors = female_survivors + 1;
            }
        } else {
            male_total = male_total + 1;
            if p.survived == 1 {
                male_survivors = male_survivors + 1;
            }
        }
    }

    let female_rate = (female_survivors * 100) / female_total;
    let male_rate = (male_survivors * 100) / male_total;

    // Assertions
    assert(female_total == 6, "Should have 6 female passengers");
    assert(male_total == 3, "Should have 3 male passengers");
    assert(female_survivors == 5, "Should have 5 female survivors");
    assert(male_survivors == 0, "Should have 0 male survivors");
    assert(female_rate > male_rate, "Female survival rate should be higher");

    println("✅ test_gender_survival PASSED");
}

// TEST 3: Class Analysis - 1st, 2nd, 3rd class survival
fun test_class_survival() {
    let mut class1_total = 0;
    let mut class1_survivors = 0;
    let mut class2_total = 0;
    let mut class2_survivors = 0;
    let mut class3_total = 0;
    let mut class3_survivors = 0;

    for p in passengers {
        if p.pclass == 1 {
            class1_total = class1_total + 1;
            if p.survived == 1 {
                class1_survivors = class1_survivors + 1;
            }
        } else if p.pclass == 2 {
            class2_total = class2_total + 1;
            if p.survived == 1 {
                class2_survivors = class2_survivors + 1;
            }
        } else if p.pclass == 3 {
            class3_total = class3_total + 1;
            if p.survived == 1 {
                class3_survivors = class3_survivors + 1;
            }
        }
    }

    let class1_rate = (class1_survivors * 100) / class1_total;
    let class2_rate = (class2_survivors * 100) / class2_total;
    let class3_rate = (class3_survivors * 100) / class3_total;

    // Assertions
    assert(class1_total == 3, "Should have 3 first class passengers");
    assert(class2_total == 3, "Should have 3 second class passengers");
    assert(class3_total == 3, "Should have 3 third class passengers");
    assert(class1_rate >= class2_rate, "1st class rate >= 2nd class rate");

    println("✅ test_class_survival PASSED");
}

// TEST 4: Age Demographics - Children, Adults, Elderly
fun test_age_demographics() {
    let mut children = 0;      // age <= 16
    let mut children_survived = 0;
    let mut adults = 0;         // 17 <= age <= 60
    let mut adults_survived = 0;
    let mut elderly = 0;        // age > 60
    let mut elderly_survived = 0;

    for p in passengers {
        if p.age <= 16 {
            children = children + 1;
            if p.survived == 1 {
                children_survived = children_survived + 1;
            }
        } else if p.age <= 60 {
            adults = adults + 1;
            if p.survived == 1 {
                adults_survived = adults_survived + 1;
            }
        } else {
            elderly = elderly + 1;
            if p.survived == 1 {
                elderly_survived = elderly_survived + 1;
            }
        }
    }

    // Assertions
    assert(children > 0, "Should have some children");
    assert(adults > 0, "Should have some adults");

    println("✅ test_age_demographics PASSED");
}

// TEST 5: Economic Analysis - Fare and Survival
fun test_fare_analysis() {
    let mut survivor_fare_total = 0.0;
    let mut survivor_count = 0;
    let mut casualty_fare_total = 0.0;
    let mut casualty_count = 0;

    for p in passengers {
        if p.survived == 1 {
            survivor_fare_total = survivor_fare_total + p.fare;
            survivor_count = survivor_count + 1;
        } else {
            casualty_fare_total = casualty_fare_total + p.fare;
            casualty_count = casualty_count + 1;
        }
    }

    let survivor_avg_fare = survivor_fare_total / survivor_count;
    let casualty_avg_fare = casualty_fare_total / casualty_count;

    // Assertions
    assert(survivor_count == 5, "Should have 5 survivors");
    assert(casualty_count == 4, "Should have 4 casualties");
    assert(survivor_avg_fare > 0, "Survivor avg fare should be positive");
    assert(casualty_avg_fare > 0, "Casualty avg fare should be positive");

    println("✅ test_fare_analysis PASSED");
}

// TEST 6: Fare Categories - Expensive, Moderate, Cheap tickets
fun test_fare_categories() {
    let mut expensive = 0;      // fare > 30
    let mut expensive_survived = 0;
    let mut moderate = 0;        // 15 <= fare <= 30
    let mut moderate_survived = 0;
    let mut cheap = 0;           // fare < 15
    let mut cheap_survived = 0;

    for p in passengers {
        if p.fare > 30.0 {
            expensive = expensive + 1;
            if p.survived == 1 {
                expensive_survived = expensive_survived + 1;
            }
        } else if p.fare >= 15.0 {
            moderate = moderate + 1;
            if p.survived == 1 {
                moderate_survived = moderate_survived + 1;
            }
        } else {
            cheap = cheap + 1;
            if p.survived == 1 {
                cheap_survived = cheap_survived + 1;
            }
        }
    }

    // Assertions
    assert(expensive + moderate + cheap == 9, "All passengers categorized");

    println("✅ test_fare_categories PASSED");
}

// TEST 7: Compound Demographics - Gender × Class
fun test_gender_class_intersection() {
    let mut first_women = 0;
    let mut first_women_survived = 0;
    let mut first_men = 0;
    let mut first_men_survived = 0;
    let mut third_women = 0;
    let mut third_women_survived = 0;
    let mut third_men = 0;
    let mut third_men_survived = 0;

    for p in passengers {
        if p.pclass == 1 && p.sex == "female" {
            first_women = first_women + 1;
            if p.survived == 1 {
                first_women_survived = first_women_survived + 1;
            }
        } else if p.pclass == 1 && p.sex == "male" {
            first_men = first_men + 1;
            if p.survived == 1 {
                first_men_survived = first_men_survived + 1;
            }
        } else if p.pclass == 3 && p.sex == "female" {
            third_women = third_women + 1;
            if p.survived == 1 {
                third_women_survived = third_women_survived + 1;
            }
        } else if p.pclass == 3 && p.sex == "male" {
            third_men = third_men + 1;
            if p.survived == 1 {
                third_men_survived = third_men_survived + 1;
            }
        }
    }

    // Assertions
    assert(first_women == 2, "Should have 2 first class women");
    assert(first_men == 1, "Should have 1 first class man");

    println("✅ test_gender_class_intersection PASSED");
}

// TEST 8: Survival Prediction Model
fun test_survival_prediction() {
    let mut correct = 0;
    let mut total = 0;

    for p in passengers {
        total = total + 1;

        // Prediction rule: High survival if female AND (1st or 2nd class)
        let high_survival = p.sex == "female" && p.pclass <= 2;
        let medium_survival = (p.sex == "female" && p.pclass == 3) || p.age <= 16;
        let predicted_survive = high_survival || medium_survival;

        let actual_survive = p.survived == 1;

        if predicted_survive == actual_survive {
            correct = correct + 1;
        }
    }

    let accuracy = (correct * 100) / total;

    // Assertions
    assert(total == 9, "Should predict for all 9 passengers");
    assert(accuracy >= 60, "Should have >= 60% accuracy");

    println("✅ test_survival_prediction PASSED");
}

// TEST 9: Average Age by Survival Status
fun test_average_age_by_survival() {
    let mut survivor_age_total = 0;
    let mut survivor_count = 0;
    let mut casualty_age_total = 0;
    let mut casualty_count = 0;

    for p in passengers {
        if p.survived == 1 {
            survivor_age_total = survivor_age_total + p.age;
            survivor_count = survivor_count + 1;
        } else {
            casualty_age_total = casualty_age_total + p.age;
            casualty_count = casualty_count + 1;
        }
    }

    let survivor_avg_age = survivor_age_total / survivor_count;
    let casualty_avg_age = casualty_age_total / casualty_count;

    // Assertions
    assert(survivor_avg_age > 0, "Survivor avg age should be positive");
    assert(casualty_avg_age > 0, "Casualty avg age should be positive");

    println("✅ test_average_age_by_survival PASSED");
}

// TEST 10: Dataset Integrity
fun test_dataset_integrity() {
    // Check all passengers have required fields
    for p in passengers {
        assert(p.id > 0, "ID should be positive");
        assert(p.survived == 0 || p.survived == 1, "Survived should be 0 or 1");
        assert(p.pclass >= 1 && p.pclass <= 3, "Class should be 1, 2, or 3");
        assert(p.age > 0, "Age should be positive");
        assert(p.fare >= 0, "Fare should be non-negative");
    }

    assert(passengers.len() == 9, "Should have 9 passengers");
    println("✅ test_dataset_integrity PASSED");
}

// MAIN: Run all tests
fun main() {
    println("Running Chapter 8.2 (Titanic Survival) Tests...\n");

    test_overall_survival();
    test_gender_survival();
    test_class_survival();
    test_age_demographics();
    test_fare_analysis();
    test_fare_categories();
    test_gender_class_intersection();
    test_survival_prediction();
    test_average_age_by_survival();
    test_dataset_integrity();

    println("\n🎉 All Chapter 8.2 tests PASSED!");
    println("Test Coverage: 10 test functions, 35+ assertions");
}
