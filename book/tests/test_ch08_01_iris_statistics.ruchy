// Test File for Chapter 8.1: Iris Dataset Statistics
// EXTREME TDD: RED phase - Write tests FIRST
// These tests will FAIL until we rewrite the chapter with working code

// Test helper: Check if two floats are approximately equal
fun approx_eq(a, b, tolerance) {
    let diff = if a > b { a - b } else { b - a };
    diff < tolerance
}

// Iris dataset for testing (sample of 9 flowers)
let iris_flowers = [
    {species: "setosa", sepal_length: 5.1, sepal_width: 3.5, petal_length: 1.4, petal_width: 0.2},
    {species: "setosa", sepal_length: 4.9, sepal_width: 3.0, petal_length: 1.4, petal_width: 0.2},
    {species: "setosa", sepal_length: 4.7, sepal_width: 3.2, petal_length: 1.3, petal_width: 0.2},
    {species: "versicolor", sepal_length: 7.0, sepal_width: 3.2, petal_length: 4.7, petal_width: 1.4},
    {species: "versicolor", sepal_length: 6.4, sepal_width: 3.2, petal_length: 4.5, petal_width: 1.5},
    {species: "versicolor", sepal_length: 6.9, sepal_width: 3.1, petal_length: 4.9, petal_width: 1.5},
    {species: "virginica", sepal_length: 6.3, sepal_width: 3.3, petal_length: 6.0, petal_width: 2.5},
    {species: "virginica", sepal_length: 5.8, sepal_width: 2.7, petal_length: 5.1, petal_width: 1.9},
    {species: "virginica", sepal_length: 7.1, sepal_width: 3.0, petal_length: 5.9, petal_width: 2.1}
];

// TEST 1: Basic Statistics - Calculate mean, min, max for sepal length
fun test_basic_sepal_statistics() {
    let mut total = 0.0;
    let mut min_val = iris_flowers[0].sepal_length;
    let mut max_val = iris_flowers[0].sepal_length;

    for flower in iris_flowers {
        total = total + flower.sepal_length;
        if flower.sepal_length < min_val {
            min_val = flower.sepal_length;
        }
        if flower.sepal_length > max_val {
            max_val = flower.sepal_length;
        }
    }

    let avg = total / iris_flowers.len();

    // Assertions
    assert(approx_eq(avg, 6.0, 0.1), "Average sepal length should be ~6.0");
    assert(approx_eq(min_val, 4.7, 0.01), "Min sepal length should be 4.7");
    assert(approx_eq(max_val, 7.1, 0.01), "Max sepal length should be 7.1");

    println("✅ test_basic_sepal_statistics PASSED");
}

// TEST 2: Species Count - GroupBy species
fun test_species_count() {
    let mut setosa_count = 0;
    let mut versicolor_count = 0;
    let mut virginica_count = 0;

    for flower in iris_flowers {
        if flower.species == "setosa" {
            setosa_count = setosa_count + 1;
        } else if flower.species == "versicolor" {
            versicolor_count = versicolor_count + 1;
        } else if flower.species == "virginica" {
            virginica_count = virginica_count + 1;
        }
    }

    // Assertions
    assert(setosa_count == 3, "Should have 3 setosa flowers");
    assert(versicolor_count == 3, "Should have 3 versicolor flowers");
    assert(virginica_count == 3, "Should have 3 virginica flowers");

    println("✅ test_species_count PASSED");
}

// TEST 3: Species Average Sepal Length - GroupBy with aggregation
fun test_species_average_sepal_length() {
    let mut setosa_total = 0.0;
    let mut setosa_count = 0;
    let mut versicolor_total = 0.0;
    let mut versicolor_count = 0;
    let mut virginica_total = 0.0;
    let mut virginica_count = 0;

    for flower in iris_flowers {
        if flower.species == "setosa" {
            setosa_total = setosa_total + flower.sepal_length;
            setosa_count = setosa_count + 1;
        } else if flower.species == "versicolor" {
            versicolor_total = versicolor_total + flower.sepal_length;
            versicolor_count = versicolor_count + 1;
        } else if flower.species == "virginica" {
            virginica_total = virginica_total + flower.sepal_length;
            virginica_count = virginica_count + 1;
        }
    }

    let setosa_avg = setosa_total / setosa_count;
    let versicolor_avg = versicolor_total / versicolor_count;
    let virginica_avg = virginica_total / virginica_count;

    // Assertions
    assert(approx_eq(setosa_avg, 4.9, 0.2), "Setosa avg sepal length ~4.9");
    assert(approx_eq(versicolor_avg, 6.77, 0.2), "Versicolor avg sepal length ~6.77");
    assert(approx_eq(virginica_avg, 6.4, 0.4), "Virginica avg sepal length ~6.4");

    println("✅ test_species_average_sepal_length PASSED");
}

// TEST 4: Species Average Petal Length - Key insight for classification
fun test_species_average_petal_length() {
    let mut setosa_total = 0.0;
    let mut setosa_count = 0;
    let mut versicolor_total = 0.0;
    let mut versicolor_count = 0;
    let mut virginica_total = 0.0;
    let mut virginica_count = 0;

    for flower in iris_flowers {
        if flower.species == "setosa" {
            setosa_total = setosa_total + flower.petal_length;
            setosa_count = setosa_count + 1;
        } else if flower.species == "versicolor" {
            versicolor_total = versicolor_total + flower.petal_length;
            versicolor_count = versicolor_count + 1;
        } else if flower.species == "virginica" {
            virginica_total = virginica_total + flower.petal_length;
            virginica_count = virginica_count + 1;
        }
    }

    let setosa_avg = setosa_total / setosa_count;
    let versicolor_avg = versicolor_total / versicolor_count;
    let virginica_avg = virginica_total / virginica_count;

    // Assertions - Key insight: Setosa has much smaller petals!
    assert(approx_eq(setosa_avg, 1.37, 0.1), "Setosa avg petal length ~1.37");
    assert(approx_eq(versicolor_avg, 4.7, 0.3), "Versicolor avg petal length ~4.7");
    assert(approx_eq(virginica_avg, 5.67, 0.5), "Virginica avg petal length ~5.67");

    // Key insight: Setosa petals are dramatically smaller
    assert(setosa_avg < 2.0, "Setosa petals should be < 2.0 cm");
    assert(versicolor_avg > 4.0, "Versicolor petals should be > 4.0 cm");
    assert(virginica_avg > 5.0, "Virginica petals should be > 5.0 cm");

    println("✅ test_species_average_petal_length PASSED");
}

// TEST 5: Feature Engineering - Petal Ratio
fun test_petal_ratio_calculation() {
    let mut ratios = [];

    for flower in iris_flowers {
        let ratio = flower.petal_length / flower.petal_width;
        ratios = ratios + [ratio];
    }

    // Assertions
    assert(ratios.len() == 9, "Should have 9 petal ratios");
    assert(ratios[0] > 0, "Ratios should be positive");

    println("✅ test_petal_ratio_calculation PASSED");
}

// TEST 6: Feature Engineering - Sepal Ratio
fun test_sepal_ratio_calculation() {
    let mut ratios = [];

    for flower in iris_flowers {
        let ratio = flower.sepal_length / flower.sepal_width;
        ratios = ratios + [ratio];
    }

    // Assertions
    assert(ratios.len() == 9, "Should have 9 sepal ratios");
    assert(ratios[0] > 0, "Ratios should be positive");

    println("✅ test_sepal_ratio_calculation PASSED");
}

// TEST 7: Pattern Discovery - Large vs Small Petals
fun test_petal_size_pattern() {
    let mut large_petal_count = 0;
    let mut small_petal_count = 0;
    let mut large_petal_species = [];
    let mut small_petal_species = [];

    for flower in iris_flowers {
        if flower.petal_length > 4.0 {
            large_petal_count = large_petal_count + 1;
            large_petal_species = large_petal_species + [flower.species];
        } else {
            small_petal_count = small_petal_count + 1;
            small_petal_species = small_petal_species + [flower.species];
        }
    }

    // Assertions
    assert(small_petal_count == 3, "Should have 3 small petal flowers (setosa)");
    assert(large_petal_count == 6, "Should have 6 large petal flowers (versicolor + virginica)");

    // Key insight: All small petal flowers should be setosa
    for species in small_petal_species {
        assert(species == "setosa", "All small petal flowers should be setosa");
    }

    println("✅ test_petal_size_pattern PASSED");
}

// TEST 8: Simple Classification Rule - Petal length threshold
fun test_classification_rule() {
    let mut correct = 0;
    let mut total = 0;

    for flower in iris_flowers {
        total = total + 1;

        // Classification rule: If petal_length > 2.5, then NOT setosa
        let predicted_setosa = flower.petal_length <= 2.5;
        let actual_setosa = flower.species == "setosa";

        if predicted_setosa == actual_setosa {
            correct = correct + 1;
        }
    }

    let accuracy = (correct * 100) / total;

    // Assertions
    assert(accuracy == 100, "Classification should be 100% accurate on sample");
    assert(total == 9, "Should classify all 9 flowers");
    assert(correct == 9, "Should correctly classify all 9 flowers");

    println("✅ test_classification_rule PASSED");
}

// TEST 9: Multi-field Statistics - All measurements for one species
fun test_setosa_full_statistics() {
    let mut sepal_l_total = 0.0;
    let mut sepal_w_total = 0.0;
    let mut petal_l_total = 0.0;
    let mut petal_w_total = 0.0;
    let mut count = 0;

    for flower in iris_flowers {
        if flower.species == "setosa" {
            sepal_l_total = sepal_l_total + flower.sepal_length;
            sepal_w_total = sepal_w_total + flower.sepal_width;
            petal_l_total = petal_l_total + flower.petal_length;
            petal_w_total = petal_w_total + flower.petal_width;
            count = count + 1;
        }
    }

    let sepal_l_avg = sepal_l_total / count;
    let sepal_w_avg = sepal_w_total / count;
    let petal_l_avg = petal_l_total / count;
    let petal_w_avg = petal_w_total / count;

    // Assertions
    assert(count == 3, "Should have 3 setosa flowers");
    assert(approx_eq(sepal_l_avg, 4.9, 0.3), "Setosa sepal length avg ~4.9");
    assert(approx_eq(petal_l_avg, 1.37, 0.1), "Setosa petal length avg ~1.37");
    assert(approx_eq(petal_w_avg, 0.2, 0.01), "Setosa petal width avg ~0.2");

    println("✅ test_setosa_full_statistics PASSED");
}

// TEST 10: Performance - Dataset size
fun test_dataset_size() {
    assert(iris_flowers.len() == 9, "Sample dataset should have 9 flowers");
    println("✅ test_dataset_size PASSED");
}

// MAIN: Run all tests
fun main() {
    println("Running Chapter 8.1 (Iris Statistics) Tests...\n");

    test_basic_sepal_statistics();
    test_species_count();
    test_species_average_sepal_length();
    test_species_average_petal_length();
    test_petal_ratio_calculation();
    test_sepal_ratio_calculation();
    test_petal_size_pattern();
    test_classification_rule();
    test_setosa_full_statistics();
    test_dataset_size();

    println("\n🎉 All Chapter 8.1 tests PASSED!");
    println("Test Coverage: 10 test functions, 30+ assertions");
}
