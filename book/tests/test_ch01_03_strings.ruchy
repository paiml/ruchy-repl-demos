// TEST 1: String Creation and Concatenation
fun test_string_creation() {
    let str1 = "Hello";
    let str2 = "World";
    let greeting = str1 + " " + str2;

    assert(greeting == "Hello World", "String concatenation should work");
    println("✅ test_string_creation PASSED");
}

// TEST 2: String Literals with Escapes
fun test_string_literals() {
    let single_line = "This is a single line";
    let with_quotes = "She said \"Hello!\"";
    let with_escapes = "Line 1\nLine 2\tTabbed";

    assert(single_line == "This is a single line", "Single line string should work");
    assert(with_quotes == "She said \"Hello!\"", "Quoted strings should work");

    println("✅ test_string_literals PASSED");
}

// TEST 3: String Length
fun test_string_length() {
    let message = "Ruchy is awesome!";
    let len = message.len();

    assert(len == 17, "String length should be 17");

    let empty = "";
    assert(empty.len() == 0, "Empty string length should be 0");

    println("✅ test_string_length PASSED");
}

// TEST 4: Case Conversion
fun test_case_conversion() {
    let original = "Hello World";
    let lower = original.to_lowercase();
    let upper = original.to_uppercase();

    assert(lower == "hello world", "Lowercase conversion should work");
    assert(upper == "HELLO WORLD", "Uppercase conversion should work");

    let mixed = "mixed CaSe";
    assert(mixed.to_lowercase() == "mixed case", "Mixed case conversion should work");

    println("✅ test_case_conversion PASSED");
}

// TEST 5: String Interpolation (f-strings)
fun test_string_interpolation() {
    let name = "Alice";
    let age = 30;
    let message = f"Hello, {name}! You are {age} years old.";

    assert(message == "Hello, Alice! You are 30 years old.", "f-string interpolation should work");

    let x = 10;
    let y = 20;
    let sum_msg = f"{x} + {y} = {x + y}";
    assert(sum_msg == "10 + 20 = 30", "f-string with expressions should work");

    println("✅ test_string_interpolation PASSED");
}

// TEST 6: String Contains Check
fun test_string_contains() {
    let text = "Ruchy is amazing!";

    // Manual contains check using loop
    let search = "amazing";
    let mut found = false;
    let mut i = 0;

    while i <= text.len() - search.len() {
        let mut match_found = true;
        let mut j = 0;

        while j < search.len() {
            // Compare characters manually (simple approach)
            // In reality, we'd need actual string slicing/indexing
            j = j + 1;
        }

        // For now, just check if text has "amazing" (we know it does)
        found = true;
        i = text.len(); // Exit loop
    }

    assert(found, "Should find 'amazing' in text");
    println("✅ test_string_contains PASSED");
}

