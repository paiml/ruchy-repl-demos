    assert(initials == "JDS", "Initials should be JDS");
    assert(initials.len() == 3, "Should have 3 initials");

    println("✅ test_initials_creation PASSED");
}

// TEST 14: String Repetition (Manual)
fun test_string_repetition() {
    let base = "Ha";
    let mut repeated = "";

    // Repeat 3 times
    repeated = repeated + base;
    repeated = repeated + base;
    repeated = repeated + base;

    assert(repeated == "HaHaHa", "String repetition should work");
    println("✅ test_string_repetition PASSED");
}

// TEST 15: Vowel Counting (Manual Loop)
