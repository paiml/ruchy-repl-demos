// TEST 1: Binary Tree Node Structure
fun test_binary_tree_node() {
    // Node with value, left, and right children (-1 means null)
    let node = {value: 10, left: -1, right: -1};

    assert(node.value == 10, "Node value should be 10");
    assert(node.left == -1, "Left child should be null");
    assert(node.right == -1, "Right child should be null");

    println("✅ test_binary_tree_node PASSED");
}

// TEST 2: Binary Tree Construction
fun test_binary_tree_construction() {
    // Build tree:
    //     10
    //    /  \
    //   5   15
    let tree = [
        {value: 10, left: 1, right: 2},   // Index 0: root
        {value: 5, left: -1, right: -1},  // Index 1: left child
        {value: 15, left: -1, right: -1}  // Index 2: right child
    ];

    assert(tree[0].value == 10, "Root value");
    assert(tree[0].left == 1, "Root left points to index 1");
    assert(tree[tree[0].left].value == 5, "Left child value");
    assert(tree[tree[0].right].value == 15, "Right child value");

    println("✅ test_binary_tree_construction PASSED");
}

// TEST 3: Tree Traversal - Pre-order (Root, Left, Right)
fun test_preorder_traversal() {
    let tree = [
        {value: 10, left: 1, right: 2},
        {value: 5, left: -1, right: -1},
        {value: 15, left: -1, right: -1}
    ];

    // Pre-order: root -> left -> right
    let mut result = [];
    let mut stack = [0];  // Start with root index

    while stack.len() > 0 {
        // Pop from stack
        let node_idx = stack[stack.len() - 1];
        let mut new_stack = [];
        let mut i = 0;
        while i < stack.len() - 1 {
            new_stack = new_stack + [stack[i]];
            i = i + 1;
        }
        stack = new_stack;

        result = result + [tree[node_idx].value];

        // Push right first (so left is processed first)
        if tree[node_idx].right != -1 {
            stack = stack + [tree[node_idx].right];
        }
        if tree[node_idx].left != -1 {
            stack = stack + [tree[node_idx].left];
        }
    }

    assert(result[0] == 10, "Pre-order: root first");
    assert(result[1] == 5, "Pre-order: left second");
    assert(result[2] == 15, "Pre-order: right third");

    println("✅ test_preorder_traversal PASSED");
}

// TEST 4: Tree Traversal - In-order (Left, Root, Right)
fun test_inorder_traversal() {
    let tree = [
        {value: 10, left: 1, right: 2},
        {value: 5, left: -1, right: -1},
        {value: 15, left: -1, right: -1}
    ];

    // In-order using manual recursion simulation
    let mut result = [];
    let mut stack = [];
    let mut current = 0;
    let mut visited = [false, false, false];

    stack = stack + [current];

    while stack.len() > 0 {
        current = stack[stack.len() - 1];

        // If has left child and not visited, go left
        if tree[current].left != -1 && !visited[tree[current].left] {
            stack = stack + [tree[current].left];
        } else {
            // Pop current
            let mut new_stack = [];
            let mut i = 0;
            while i < stack.len() - 1 {
                new_stack = new_stack + [stack[i]];
                i = i + 1;
            }
            stack = new_stack;

            result = result + [tree[current].value];
            visited[current] = true;

            // If has right child, go right
            if tree[current].right != -1 && !visited[tree[current].right] {
                stack = stack + [tree[current].right];
            }
        }
    }

    assert(result[0] == 5, "In-order: left first");
    assert(result[1] == 10, "In-order: root second");
    assert(result[2] == 15, "In-order: right third");

    println("✅ test_inorder_traversal PASSED");
}

// TEST 5: Tree Height Calculation
fun test_tree_height() {
    let tree = [
        {value: 10, left: 1, right: 2},
        {value: 5, left: 3, right: -1},
        {value: 15, left: -1, right: -1},
        {value: 3, left: -1, right: -1}
    ];

    // Calculate height using level tracking
    let mut max_height = 0;
    let mut queue = [{node: 0, level: 0}];

    while queue.len() > 0 {
        let current = queue[0];

        // Dequeue
        let mut new_queue = [];
        let mut i = 1;
        while i < queue.len() {
            new_queue = new_queue + [queue[i]];
            i = i + 1;
        }
        queue = new_queue;

        if current.level > max_height {
            max_height = current.level;
        }

        let node_idx = current.node;
        let node = tree[node_idx];

        if node.left != -1 {
            queue = queue + [{node: node.left, level: current.level + 1}];
        }
        if node.right != -1 {
            queue = queue + [{node: node.right, level: current.level + 1}];
        }
    }

    assert(max_height == 2, "Tree height should be 2");

    println("✅ test_tree_height PASSED");
}

// TEST 6: Binary Search Tree - Search
fun test_bst_search() {
    // BST property: left < root < right
    let bst = [
        {value: 10, left: 1, right: 2},
        {value: 5, left: -1, right: -1},
        {value: 15, left: -1, right: -1}
    ];

    // Search for 5
    let target = 5;
    let mut current = 0;
    let mut found = false;

    while current != -1 {
        if bst[current].value == target {
            found = true;
            break;
        } else if target < bst[current].value {
            current = bst[current].left;
        } else {
            current = bst[current].right;
        }
    }

    assert(found == true, "Should find 5 in BST");

    // Search for 20 (not in tree)
    target = 20;
    current = 0;
    found = false;

    while current != -1 {
        if bst[current].value == target {
            found = true;
            break;
        } else if target < bst[current].value {
            current = bst[current].left;
        } else {
            current = bst[current].right;
        }
    }

    assert(found == false, "Should not find 20 in BST");

    println("✅ test_bst_search PASSED");
}

// TEST 7: Tree Size (Node Count)
fun test_tree_size() {
    let tree = [
        {value: 10, left: 1, right: 2},
        {value: 5, left: 3, right: -1},
        {value: 15, left: -1, right: -1},
        {value: 3, left: -1, right: -1}
    ];

    let size = tree.len();
    assert(size == 4, "Tree should have 4 nodes");

    println("✅ test_tree_size PASSED");
}

// TEST 8: Graph - Adjacency List Representation
fun test_graph_adjacency_list() {
    // Graph: A -> B, A -> C, B -> D, C -> D
    let graph = [
        {node: "A", neighbors: ["B", "C"]},
        {node: "B", neighbors: ["D"]},
        {node: "C", neighbors: ["D"]},
        {node: "D", neighbors: []}
    ];

    assert(graph[0].node == "A", "First node is A");
    assert(graph[0].neighbors.len() == 2, "A has 2 neighbors");
    assert(graph[0].neighbors[0] == "B", "A connects to B");

    println("✅ test_graph_adjacency_list PASSED");
}

// TEST 9: Graph - Breadth-First Search (BFS)
fun test_graph_bfs() {
    let graph = [
        {node: "A", neighbors: ["B", "C"]},
        {node: "B", neighbors: ["D"]},
        {node: "C", neighbors: ["D"]},
        {node: "D", neighbors: []}
    ];

    // BFS from A
    let mut visited = [];
    let mut queue = ["A"];

    while queue.len() > 0 {
        // Dequeue
        let current = queue[0];
        let mut new_queue = [];
        let mut i = 1;
        while i < queue.len() {
            new_queue = new_queue + [queue[i]];
            i = i + 1;
        }
        queue = new_queue;

        // Check if already visited
        let mut already_visited = false;
        for v in visited {
            if v == current {
                already_visited = true;
                break;
            }
        }

        if !already_visited {
            visited = visited + [current];

            // Find neighbors
            for entry in graph {
                if entry.node == current {
                    for neighbor in entry.neighbors {
                        queue = queue + [neighbor];
                    }
                    break;
                }
            }
        }
    }

    assert(visited.len() == 4, "Should visit all 4 nodes");
    assert(visited[0] == "A", "First visited is A");

    println("✅ test_graph_bfs PASSED");
}

// TEST 10: Graph - Depth-First Search (DFS)
fun test_graph_dfs() {
    let graph = [
        {node: "A", neighbors: ["B", "C"]},
        {node: "B", neighbors: ["D"]},
        {node: "C", neighbors: ["D"]},
        {node: "D", neighbors: []}
    ];

    // DFS from A using stack
    let mut visited = [];
    let mut stack = ["A"];

    while stack.len() > 0 {
        // Pop
        let current = stack[stack.len() - 1];
        let mut new_stack = [];
        let mut i = 0;
        while i < stack.len() - 1 {
            new_stack = new_stack + [stack[i]];
            i = i + 1;
        }
        stack = new_stack;

        // Check if already visited
        let mut already_visited = false;
        for v in visited {
            if v == current {
                already_visited = true;
                break;
            }
        }

        if !already_visited {
            visited = visited + [current];

            // Find neighbors and push to stack
            for entry in graph {
                if entry.node == current {
                    // Push neighbors in reverse order for left-to-right processing
                    let mut i = entry.neighbors.len();
                    while i > 0 {
                        i = i - 1;
                        stack = stack + [entry.neighbors[i]];
                    }
                    break;
                }
            }
        }
    }

    assert(visited.len() == 4, "Should visit all 4 nodes");
    assert(visited[0] == "A", "First visited is A");

    println("✅ test_graph_dfs PASSED");
}

// TEST 11: Directed Graph - Has Cycle Detection
fun test_graph_has_cycle() {
    // Graph with cycle: A -> B -> C -> A
    let graph = [
        {node: "A", neighbors: ["B"]},
        {node: "B", neighbors: ["C"]},
        {node: "C", neighbors: ["A"]}
    ];

    // Simple cycle detection: if we revisit a node in current path
    let mut has_cycle = false;
    let mut visited = [];
    let mut path = ["A"];

    while path.len() > 0 && !has_cycle {
        let current = path[path.len() - 1];

        // Mark as visited
        let mut already_visited = false;
        for v in visited {
            if v == current {
                already_visited = true;
                break;
            }
        }

        if already_visited {
            has_cycle = true;
        } else {
            visited = visited + [current];

            // Pop current
            let mut new_path = [];
            let mut i = 0;
            while i < path.len() - 1 {
                new_path = new_path + [path[i]];
                i = i + 1;
            }
            path = new_path;

            // Add neighbors to path
            for entry in graph {
                if entry.node == current {
                    for neighbor in entry.neighbors {
                        path = path + [neighbor];
                    }
                    break;
                }
            }
        }
    }

    assert(has_cycle == true, "Should detect cycle");

    println("✅ test_graph_has_cycle PASSED");
}

// TEST 12: Weighted Graph
fun test_weighted_graph() {
    // Graph with weights: A -5-> B, A -3-> C, B -2-> D
    let graph = [
        {node: "A", edges: [{to: "B", weight: 5}, {to: "C", weight: 3}]},
        {node: "B", edges: [{to: "D", weight: 2}]},
        {node: "C", edges: [{to: "D", weight: 4}]},
        {node: "D", edges: []}
    ];

    // Find edge weight A -> B
    let mut weight_ab = -1;
    for entry in graph {
        if entry.node == "A" {
            for edge in entry.edges {
                if edge.to == "B" {
                    weight_ab = edge.weight;
                    break;
                }
            }
            break;
        }
    }

    assert(weight_ab == 5, "Edge A->B should have weight 5");

    println("✅ test_weighted_graph PASSED");
}

// TEST 13: Undirected Graph Representation
fun test_undirected_graph() {
    // Undirected graph: A-B, A-C, B-C (bidirectional edges)
    let graph = [
        {node: "A", neighbors: ["B", "C"]},
        {node: "B", neighbors: ["A", "C"]},
        {node: "C", neighbors: ["A", "B"]}
    ];

    // Check A is neighbor of B
    let mut a_in_b_neighbors = false;
    for entry in graph {
        if entry.node == "B" {
            for neighbor in entry.neighbors {
                if neighbor == "A" {
                    a_in_b_neighbors = true;
                    break;
                }
            }
            break;
        }
    }

    assert(a_in_b_neighbors == true, "Undirected: A should be in B's neighbors");

    println("✅ test_undirected_graph PASSED");
}

// TEST 14: Path Finding (Simple)
fun test_path_finding() {
    let graph = [
        {node: "A", neighbors: ["B", "C"]},
        {node: "B", neighbors: ["D"]},
        {node: "C", neighbors: ["D"]},
        {node: "D", neighbors: []}
    ];

    // Find path from A to D using BFS
    let start = "A";
    let target = "D";
    let mut queue = [{node: start, path: [start]}];
    let mut found_path = [];

    while queue.len() > 0 && found_path.len() == 0 {
        let current = queue[0];

        // Dequeue
        let mut new_queue = [];
        let mut i = 1;
        while i < queue.len() {
            new_queue = new_queue + [queue[i]];
            i = i + 1;
        }
        queue = new_queue;

        if current.node == target {
            found_path = current.path;
        } else {
            // Find neighbors
            for entry in graph {
                if entry.node == current.node {
                    for neighbor in entry.neighbors {
                        let new_path = current.path + [neighbor];
                        queue = queue + [{node: neighbor, path: new_path}];
                    }
                    break;
                }
            }
        }
    }

    assert(found_path.len() > 0, "Should find path from A to D");
    assert(found_path[0] == "A", "Path starts at A");
    assert(found_path[found_path.len() - 1] == "D", "Path ends at D");

    println("✅ test_path_finding PASSED");
}

// TEST 15: Tree - Level Order Traversal
fun test_level_order_traversal() {
    let tree = [
        {value: 10, left: 1, right: 2},
        {value: 5, left: 3, right: -1},
        {value: 15, left: -1, right: -1},
        {value: 3, left: -1, right: -1}
    ];

    // Level order: visit level by level
    let mut result = [];
    let mut queue = [0];  // Start with root index

    while queue.len() > 0 {
        let node_idx = queue[0];

        // Dequeue
        let mut new_queue = [];
        let mut i = 1;
        while i < queue.len() {
            new_queue = new_queue + [queue[i]];
            i = i + 1;
        }
        queue = new_queue;

        result = result + [tree[node_idx].value];

        if tree[node_idx].left != -1 {
            queue = queue + [tree[node_idx].left];
        }
        if tree[node_idx].right != -1 {
            queue = queue + [tree[node_idx].right];
        }
    }

    assert(result[0] == 10, "Level 0: root");
    assert(result[1] == 5, "Level 1: left");
    assert(result[2] == 15, "Level 1: right");
    assert(result[3] == 3, "Level 2: left-left");

    println("✅ test_level_order_traversal PASSED");
}

