    test_graph_dfs();
    test_graph_has_cycle();
    test_weighted_graph();
    test_undirected_graph();
    test_path_finding();
    test_level_order_traversal();

    println("\n🎉 All Chapter 3.4 tests PASSED!");
    println("Test Coverage: 15 test functions, 35+ assertions");
}
