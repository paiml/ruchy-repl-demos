fun main() {
    println("Running Chapter 2.5 (Function Composition) Tests...\n");

    test_simple_composition();
    test_pipe();
    test_three_function_composition();
    test_math_composition();
    test_string_composition();
    test_validation_composition();
    test_composition_builder();
    test_array_pipeline();
    test_composition_with_closures();
    test_reverse_composition();
    test_multi_step_transformation();
    test_identity_composition();
    test_temperature_pipeline();
    test_predicate_and_composition();
    test_partial_with_composition();

    println("\n🎉 All Chapter 2.5 tests PASSED!");
    println("Test Coverage: 15 test functions, 30+ assertions");
}
