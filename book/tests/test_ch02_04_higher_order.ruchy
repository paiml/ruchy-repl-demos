// Test File for Chapter 2.4: Higher-Order Functions
// EXTREME TDD: RED phase - Write tests FIRST
// Using ONLY verified Ruchy v3.194.0 patterns

// TEST 1: Function as Parameter (Simple)
fun test_function_as_parameter() {
    fun apply(f, x) {
        f(x)
    }

    fun double(n) {
        n * 2
    }

    let result = apply(double, 5);
    assert(result == 10, "apply(double, 5) should be 10");

    println("✅ test_function_as_parameter PASSED");
}

// TEST 2: Multiple Functions as Parameters
fun test_multiple_function_params() {
    fun combine(f, g, x) {
        f(g(x))
    }

    fun add_one(n) {
        n + 1
    }

    fun double(n) {
        n * 2
    }

    let result = combine(double, add_one, 5);  // double(add_one(5)) = double(6) = 12
    assert(result == 12, "combine should work");

    println("✅ test_multiple_function_params PASSED");
}

// TEST 3: Manual Map Implementation
fun test_manual_map() {
    fun map(arr, f) {
        let mut result = [];
        for item in arr {
            result = result + [f(item)];
        }
        result
    }

    fun double(n) {
        n * 2
    }

    let numbers = [1, 2, 3, 4, 5];
    let doubled = map(numbers, double);

    assert(doubled[0] == 2, "First element should be 2");
    assert(doubled[4] == 10, "Last element should be 10");

    println("✅ test_manual_map PASSED");
}

// TEST 4: Manual Filter Implementation
fun test_manual_filter() {
    fun filter(arr, predicate) {
        let mut result = [];
        for item in arr {
            if predicate(item) {
                result = result + [item];
            }
        }
        result
    }

    fun is_even(n) {
        n % 2 == 0
    }

    let numbers = [1, 2, 3, 4, 5, 6];
    let evens = filter(numbers, is_even);

    assert(evens.len() == 3, "Should have 3 even numbers");
    assert(evens[0] == 2, "First even is 2");
    assert(evens[1] == 4, "Second even is 4");

    println("✅ test_manual_filter PASSED");
}

// TEST 5: Manual Reduce Implementation
fun test_manual_reduce() {
    fun reduce(arr, f, initial) {
        let mut acc = initial;
        for item in arr {
            acc = f(acc, item);
        }
        acc
    }

    fun add(a, b) {
        a + b
    }

    let numbers = [1, 2, 3, 4, 5];
    let sum = reduce(numbers, add, 0);

    assert(sum == 15, "Sum should be 15");

    println("✅ test_manual_reduce PASSED");
}

// TEST 6: Callback Pattern (forEach)
fun test_foreach_callback() {
    fun foreach(arr, callback) {
        for item in arr {
            callback(item);
        }
    }

    let mut sum = 0;

    fun add_to_sum(n) {
        sum = sum + n;
    }

    let numbers = [1, 2, 3];
    foreach(numbers, add_to_sum);

    assert(sum == 6, "Sum should be 6");

    println("✅ test_foreach_callback PASSED");
}

// TEST 7: Sorting with Comparator
fun test_sort_with_comparator() {
    fun manual_sort(arr, compare) {
        // Simplified bubble sort for testing
        let mut sorted = arr;
        let mut changed = true;

        while changed {
            changed = false;
            let mut i = 0;
            while i < sorted.len() - 1 {
                if compare(sorted[i], sorted[i + 1]) {
                    // Swap
                    let temp = sorted[i];
                    sorted[i] = sorted[i + 1];
                    sorted[i + 1] = temp;
                    changed = true;
                }
                i = i + 1;
            }
        }

        sorted
    }

    fun descending(a, b) {
        a < b  // Returns true if should swap
    }

    let numbers = [3, 1, 4, 1, 5];
    let sorted = manual_sort(numbers, descending);

    assert(sorted[0] == 5, "First should be 5");
    assert(sorted[4] == 1, "Last should be 1");

    println("✅ test_sort_with_comparator PASSED");
}

// TEST 8: Transform with Multiple Operations
fun test_transform_chain() {
    fun transform_all(arr, f1, f2) {
        let mut result = [];
        for item in arr {
            result = result + [f2(f1(item))];
        }
        result
    }

    fun add_one(n) {
        n + 1
    }

    fun double(n) {
        n * 2
    }

    let numbers = [1, 2, 3];
    let transformed = transform_all(numbers, add_one, double);

    assert(transformed[0] == 4, "(1+1)*2 = 4");
    assert(transformed[2] == 8, "(3+1)*2 = 8");

    println("✅ test_transform_chain PASSED");
}

// TEST 9: Find with Predicate
fun test_find_with_predicate() {
    fun find(arr, predicate) {
        for item in arr {
            if predicate(item) {
                return item;
            }
        }
        -1  // Not found
    }

    fun is_greater_than_5(n) {
        n > 5
    }

    let numbers = [1, 2, 6, 3, 8];
    let result = find(numbers, is_greater_than_5);

    assert(result == 6, "First item > 5 is 6");

    println("✅ test_find_with_predicate PASSED");
}

// TEST 10: Count with Predicate
fun test_count_with_predicate() {
    fun count(arr, predicate) {
        let mut total = 0;
        for item in arr {
            if predicate(item) {
                total = total + 1;
            }
        }
        total
    }

    fun is_positive(n) {
        n > 0
    }

    let numbers = [-2, 3, -1, 5, 0, 7];
    let positive_count = count(numbers, is_positive);

    assert(positive_count == 3, "Should have 3 positive numbers");

    println("✅ test_count_with_predicate PASSED");
}

// TEST 11: Partition with Predicate
fun test_partition() {
    fun partition(arr, predicate) {
        let mut true_part = [];
        let mut false_part = [];

        for item in arr {
            if predicate(item) {
                true_part = true_part + [item];
            } else {
                false_part = false_part + [item];
            }
        }

        {true: true_part, false: false_part}
    }

    fun is_even(n) {
        n % 2 == 0
    }

    let numbers = [1, 2, 3, 4, 5, 6];
    let parts = partition(numbers, is_even);

    assert(parts.true.len() == 3, "Should have 3 even numbers");
    assert(parts.false.len() == 3, "Should have 3 odd numbers");

    println("✅ test_partition PASSED");
}

// TEST 12: Any/All with Predicate
fun test_any_all() {
    fun any(arr, predicate) {
        for item in arr {
            if predicate(item) {
                return true;
            }
        }
        false
    }

    fun all(arr, predicate) {
        for item in arr {
            if !predicate(item) {
                return false;
            }
        }
        true
    }

    fun is_positive(n) {
        n > 0
    }

    let mixed = [1, 2, -3, 4];
    assert(any(mixed, is_positive) == true, "Any should find positive");
    assert(all(mixed, is_positive) == false, "All should fail (has negative)");

    let all_positive = [1, 2, 3, 4];
    assert(all(all_positive, is_positive) == true, "All positive");

    println("✅ test_any_all PASSED");
}

// TEST 13: Compose Functions
fun test_compose() {
    fun compose(f, g) {
        fun composed(x) {
            f(g(x))
        }
        composed
    }

    fun add_one(n) {
        n + 1
    }

    fun double(n) {
        n * 2
    }

    let add_then_double = compose(double, add_one);
    assert(add_then_double(5) == 12, "(5+1)*2 = 12");

    println("✅ test_compose PASSED");
}

// TEST 14: Pipe (Reverse Composition)
fun test_pipe() {
    fun pipe(f, g) {
        fun piped(x) {
            g(f(x))
        }
        piped
    }

    fun add_one(n) {
        n + 1
    }

    fun double(n) {
        n * 2
    }

    let double_then_add = pipe(double, add_one);
    assert(double_then_add(5) == 11, "(5*2)+1 = 11");

    println("✅ test_pipe PASSED");
}

// TEST 15: Currying
fun test_currying() {
    fun curry_add(a) {
        fun add_b(b) {
            a + b
        }
        add_b
    }

    let add_5 = curry_add(5);
    assert(add_5(3) == 8, "5 + 3 = 8");
    assert(add_5(10) == 15, "5 + 10 = 15");

    let add_10 = curry_add(10);
    assert(add_10(3) == 13, "10 + 3 = 13");

    println("✅ test_currying PASSED");
}

// MAIN: Run all tests
fun main() {
    println("Running Chapter 2.4 (Higher-Order Functions) Tests...\n");

    test_function_as_parameter();
    test_multiple_function_params();
    test_manual_map();
    test_manual_filter();
    test_manual_reduce();
    test_foreach_callback();
    test_sort_with_comparator();
    test_transform_chain();
    test_find_with_predicate();
    test_count_with_predicate();
    test_partition();
    test_any_all();
    test_compose();
    test_pipe();
    test_currying();

    println("\n🎉 All Chapter 2.4 tests PASSED!");
    println("Test Coverage: 15 test functions, 35+ assertions");
}
