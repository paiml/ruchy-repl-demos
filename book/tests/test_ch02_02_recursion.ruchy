// TEST 1: Simple Factorial (Base Case + Recursive Case)
fun test_factorial() {
    fun factorial(n) {
        if n <= 1 {
            1
        } else {
            n * factorial(n - 1)
        }
    }

    assert(factorial(0) == 1, "factorial(0) should be 1");
    assert(factorial(1) == 1, "factorial(1) should be 1");
    assert(factorial(5) == 120, "factorial(5) should be 120");
    assert(factorial(7) == 5040, "factorial(7) should be 5040");

    println("✅ test_factorial PASSED");
}

// TEST 2: Fibonacci Sequence (Classic Recursion)
fun test_fibonacci() {
    fun fib(n) {
        if n <= 1 {
            n
        } else {
            fib(n - 1) + fib(n - 2)
        }
    }

    assert(fib(0) == 0, "fib(0) should be 0");
    assert(fib(1) == 1, "fib(1) should be 1");
    assert(fib(5) == 5, "fib(5) should be 5");
    assert(fib(10) == 55, "fib(10) should be 55");

    println("✅ test_fibonacci PASSED");
}

// TEST 3: Sum of Numbers (Recursive Accumulation)
fun test_sum_recursive() {
    fun sum(n) {
        if n <= 0 {
            0
        } else {
            n + sum(n - 1)
        }
    }

    assert(sum(0) == 0, "sum(0) should be 0");
    assert(sum(5) == 15, "sum(5) should be 15");  // 1+2+3+4+5
    assert(sum(10) == 55, "sum(10) should be 55");

    println("✅ test_sum_recursive PASSED");
}

// TEST 4: Array Sum (Recursive Array Processing)
fun test_array_sum_recursive() {
    fun sum_array(arr, index) {
        if index >= arr.len() {
            0
        } else {
            arr[index] + sum_array(arr, index + 1)
        }
    }

    let nums1 = [1, 2, 3, 4, 5];
    assert(sum_array(nums1, 0) == 15, "sum should be 15");

    let nums2 = [10, 20, 30];
    assert(sum_array(nums2, 0) == 60, "sum should be 60");

    println("✅ test_array_sum_recursive PASSED");
}

// TEST 5: Count Down (Simple Recursion)
fun test_count_down() {
    fun count_down(n) {
        if n <= 0 {
            "Done!"
        } else {
            count_down(n - 1)
        }
    }

    let result = count_down(5);
    assert(result == "Done!", "count_down should reach Done!");

    println("✅ test_count_down PASSED");
}

// TEST 6: Power Function (x^n)
fun test_power_recursive() {
    fun power(base, exp) {
        if exp == 0 {
            1
        } else {
            base * power(base, exp - 1)
        }
    }

    assert(power(2, 0) == 1, "2^0 should be 1");
    assert(power(2, 3) == 8, "2^3 should be 8");
    assert(power(5, 2) == 25, "5^2 should be 25");
    assert(power(3, 4) == 81, "3^4 should be 81");

    println("✅ test_power_recursive PASSED");
}

// TEST 7: GCD (Greatest Common Divisor - Euclidean Algorithm)
fun test_gcd() {
    fun gcd(a, b) {
        if b == 0 {
            a
        } else {
            gcd(b, a % b)
        }
    }

    assert(gcd(48, 18) == 6, "gcd(48, 18) should be 6");
    assert(gcd(100, 35) == 5, "gcd(100, 35) should be 5");
    assert(gcd(17, 13) == 1, "gcd(17, 13) should be 1");

    println("✅ test_gcd PASSED");
}

