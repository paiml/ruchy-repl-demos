// TEST 15: Mutual Recursion (Even/Odd Check)
fun test_mutual_recursion() {
    fun is_even(n) {
        if n == 0 {
            true
        } else {
            is_odd(n - 1)
        }
    }

    fun is_odd(n) {
        if n == 0 {
            false
        } else {
            is_even(n - 1)
        }
    }

    assert(is_even(0) == true, "0 is even");
    assert(is_even(4) == true, "4 is even");
    assert(is_even(7) == false, "7 is not even");
    assert(is_odd(3) == true, "3 is odd");
    assert(is_odd(6) == false, "6 is not odd");

    println("✅ test_mutual_recursion PASSED");
}

