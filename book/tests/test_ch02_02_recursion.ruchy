// TEST 9: Array Max (Recursive Finding Maximum)
fun test_array_max_recursive() {
    fun max_from(arr, index, current_max) {
        if index >= arr.len() {
            current_max
        } else {
            let new_max = if arr[index] > current_max {
                arr[index]
            } else {
                current_max
            };
            max_from(arr, index + 1, new_max)
        }
    }

    let nums = [3, 7, 2, 9, 1];
    let result = max_from(nums, 1, nums[0]);
    assert(result == 9, "Max should be 9");

    println("✅ test_array_max_recursive PASSED");
}

// TEST 10: Reverse Number (Digit Recursion)
fun test_reverse_number() {
    fun reverse_helper(n, acc) {
        if n == 0 {
            acc
        } else {
            reverse_helper(n / 10, acc * 10 + (n % 10))
        }
    }

    fun reverse(n) {
        reverse_helper(n, 0)
    }

    assert(reverse(123) == 321, "reverse(123) should be 321");
    assert(reverse(456) == 654, "reverse(456) should be 654");
    assert(reverse(100) == 1, "reverse(100) should be 1");

    println("✅ test_reverse_number PASSED");
}

// TEST 11: Count Occurrences in Array
fun test_count_occurrences() {
    fun count_value(arr, index, target, count) {
        if index >= arr.len() {
            count
        } else {
            let new_count = if arr[index] == target {
                count + 1
            } else {
                count
            };
            count_value(arr, index + 1, target, new_count)
        }
    }

    let numbers = [1, 2, 3, 2, 4, 2, 5];
    let result = count_value(numbers, 0, 2, 0);
    assert(result == 3, "Should find 3 occurrences of 2");

    println("✅ test_count_occurrences PASSED");
}

// TEST 12: Binary Search (Recursive Search)
fun test_binary_search_recursive() {
    fun binary_search(arr, target, left, right) {
        if left > right {
            -1  // Not found
        } else {
            let mid = (left + right) / 2;
            if arr[mid] == target {
                mid
            } else if arr[mid] > target {
                binary_search(arr, target, left, mid - 1)
            } else {
                binary_search(arr, target, mid + 1, right)
            }
        }
    }

    let sorted = [1, 3, 5, 7, 9, 11, 13];
    let idx = binary_search(sorted, 7, 0, sorted.len() - 1);
    assert(idx == 3, "Should find 7 at index 3");

    let not_found = binary_search(sorted, 8, 0, sorted.len() - 1);
    assert(not_found == -1, "Should return -1 for not found");

    println("✅ test_binary_search_recursive PASSED");
}

// TEST 13: Sum of Digits (Recursive Digit Processing)
fun test_sum_of_digits() {
    fun digit_sum(n) {
        if n == 0 {
            0
        } else {
            (n % 10) + digit_sum(n / 10)
        }
    }

    assert(digit_sum(123) == 6, "1+2+3 should be 6");
    assert(digit_sum(456) == 15, "4+5+6 should be 15");
    assert(digit_sum(999) == 27, "9+9+9 should be 27");

    println("✅ test_sum_of_digits PASSED");
}

