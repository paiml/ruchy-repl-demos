// Test file for Chapter 1.1: Arithmetic Operations
// Extracted from book/src/ch01-01-arithmetic.md
// Target: Ruchy v3.63.0

// Basic arithmetic
fun test_basic_arithmetic() {
    assert_eq(2 + 2, 4)
    assert_eq(10 + 5, 15)
    assert_eq(100 - 25, 75)
    assert_eq(7 + 3 - 2, 8)
}

// Multiplication and division
fun test_multiplication_division() {
    assert_eq(10 * 5, 50)
    assert_eq(50 / 2, 25)
    assert_eq(7 * 3, 21)
    assert_eq(7 / 2, 3.5)
    assert_eq(15 / 4, 3.75)
}

// Modulo operations
fun test_modulo() {
    assert_eq(17 % 5, 2)
    assert_eq(20 % 6, 2)
    assert_eq(15 % 3, 0)
}

// Exponentiation
fun test_exponentiation() {
    assert_eq(2 ** 8, 256)
    assert_eq(3 ** 4, 81)
    assert_eq(10 ** 3, 1000)
}

// Operator precedence
fun test_operator_precedence() {
    assert_eq(2 + 3 * 4, 14)
    assert_eq((2 + 3) * 4, 20)
    assert_eq(2 ** 3 + 1, 9)
}

// Number types
fun test_number_types() {
    let integer = 42
    let float = 3.14159
    assert_eq(integer + float, 45.14159)
}

// Integer operations
fun test_integer_operations() {
    assert_eq(5 + 3, 8)
    assert_eq(10 - 7, 3)
    assert_eq(4 * 6, 24)
}

// Floating-point operations
fun test_float_operations() {
    assert_eq(3.14 + 2.86, 6.0)
    assert_eq(7.5 / 2.5, 3.0)
    assert_eq(2.5 * 4.0, 10.0)
}

// Mixed operations
fun test_mixed_operations() {
    assert_eq(5 + 3.14, 8.14)
    assert_eq(10 * 2.5, 25.0)
    assert_eq(7 / 2.0, 3.5)
}

// Practical example: Circle area
fun test_circle_area() {
    let pi = 3.14159
    let radius = 5
    let area = pi * radius * radius
    assert_eq(area, 78.53975)
}

// Practical example: Temperature conversion
fun test_temperature_conversion() {
    let celsius = 25
    let fahrenheit = celsius * 9 / 5 + 32
    assert_eq(fahrenheit, 77.0)
}

// Practical example: Compound interest
fun test_compound_interest() {
    let principal = 1000
    let rate = 0.05
    let time = 3
    let amount = principal * (1 + rate) ** time
    assert_eq(amount, 1157.625)
}

// Exercise solutions
fun test_exercise_solutions() {
    // Exercise 1: Compound interest for $5000 at 3% for 5 years
    assert_eq(5000 * (1 + 0.03) ** 5, 5796.370549)

    // Exercise 2: Remainder when 123 is divided by 7
    assert_eq(123 % 7, 4)

    // Exercise 3: Volume of sphere with radius 3
    let r = 3
    let volume = 4.0 / 3.0 * 3.14159 * r ** 3
    assert_eq(volume, 113.097324)
}
