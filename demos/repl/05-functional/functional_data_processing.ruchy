// Functional Programming: Data Processing
// Verified features: practical functional patterns for data

println("=== Functional Data Processing ===\n");

println("1. Extract-Transform-Load:");
let raw_data = [
    {name: "Alice", score: 85},
    {name: "Bob", score: 92},
    {name: "Carol", score: 78}
];

println("Raw data:");
for item in raw_data {
    println(f"  {item.name}: {item.score}");
}

let scores = raw_data.map(|item| item.score);
let total = scores.sum();
let average = total / scores.len();
println(f"\nAverage score: {average}");

println("\n2. Filter-Map-Reduce:");
let sales = [
    {product: "A", amount: 100, paid: true},
    {product: "B", amount: 150, paid: false},
    {product: "C", amount: 200, paid: true},
    {product: "D", amount: 75, paid: true}
];

let paid_amounts = sales
    .filter(|s| s.paid)
    .map(|s| s.amount);

let revenue = paid_amounts.sum();
println(f"Total revenue from paid orders: ${revenue}");

println("\n3. Data Aggregation:");
let temperatures = [72, 68, 75, 71, 79, 73, 70];
println(f"Temperatures: {temperatures:?}");

let total_temp = temperatures.sum();
let count = temperatures.len();
let avg_temp = total_temp / count;

let above_avg = temperatures.filter(|t| t > avg_temp);
println(f"Average: {avg_temp}°F");
println(f"Above average: {above_avg:?}");

println("\n4. Data Enrichment:");
let products = [
    {name: "Widget", price: 10},
    {name: "Gadget", price: 20},
    {name: "Doohickey", price: 15}
];

let with_tax = products.map(|p| {
    let tax = p.price * 0.08;
    let total = p.price + tax;
    {name: p.name, price: p.price, tax: tax, total: total}
});

println("Price breakdown:");
for item in with_tax {
    println(f"  {item.name}: ${item.price} + ${item.tax} tax = ${item.total}");
}

println("\n5. Data Quality Checks:");
let measurements = [25.5, 26.0, 150.0, 25.8, 26.2, -5.0, 25.9];
println(f"Raw: {measurements:?}");

let valid = measurements.filter(|m| m >= 20.0 && m <= 30.0);
let invalid = measurements.filter(|m| m < 20.0 || m > 30.0);

println(f"Valid (20-30): {valid:?}");
println(f"Invalid: {invalid:?}");
println(f"Data quality: {valid.len()}/{measurements.len()} valid");

println("\n✅ Functional Data Processing Complete!");
