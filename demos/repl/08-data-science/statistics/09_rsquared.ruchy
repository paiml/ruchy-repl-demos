// Statistical Demo 9: R-squared - Model Quality Assessment
// Concepts: R², coefficient of determination, model fit, explained variance
// Use cases: Regression evaluation, model selection, goodness of fit

println("=== R-Squared: Measuring Model Fit Quality ===\n");

// 1. R-squared Basics
println("1. R-SQUARED (R²) Basics:");
println("   Formula: R² = 1 - (SS_res / SS_tot)");
println("   Range: 0 to 1 (or 0% to 100%)");
println("   Meaning: Proportion of variance explained by model");

// Perfect fit example
let x_perfect = [1, 2, 3, 4, 5];
let y_perfect = [2, 4, 6, 8, 10]; // y = 2x (perfect linear)

// Calculate mean
let mean_y_perfect = y_perfect.sum() / y_perfect.len();

// Total sum of squares (SS_tot)
let mut ss_tot_perfect = 0.0;
for y in y_perfect {
    ss_tot_perfect = ss_tot_perfect + ((y - mean_y_perfect) * (y - mean_y_perfect));
}

// Simple regression: y = 2x
let mut ss_res_perfect = 0.0;
for i in 0..x_perfect.len() {
    let y_pred = 2 * x_perfect[i];
    ss_res_perfect = ss_res_perfect + ((y_perfect[i] - y_pred) * (y_perfect[i] - y_pred));
}

let r_squared_perfect = 1.0 - (ss_res_perfect / ss_tot_perfect);

println(f"\nPerfect fit data:");
println(f"X: {x_perfect:?}");
println(f"Y: {y_perfect:?}");
println(f"Model: y = 2x");
println(f"R² = {r_squared_perfect:.3f} (100% variance explained)");

// 2. Imperfect fit
println("\n2. IMPERFECT Fit:");

let x_real = [1, 2, 3, 4, 5];
let y_real = [2.1, 3.9, 6.2, 7.8, 10.1]; // Close to y = 2x but with noise

let mean_y_real = y_real.sum() / y_real.len();

// Total sum of squares
let mut ss_tot_real = 0.0;
for y in y_real {
    ss_tot_real = ss_tot_real + ((y - mean_y_real) * (y - mean_y_real));
}

// Residual sum of squares (using y = 2x model)
let mut ss_res_real = 0.0;
for i in 0..x_real.len() {
    let y_pred = 2.0 * x_real[i];
    ss_res_real = ss_res_real + ((y_real[i] - y_pred) * (y_real[i] - y_pred));
}

let r_squared_real = 1.0 - (ss_res_real / ss_tot_real);

println(f"\nReal-world data (with noise):");
println(f"X: {x_real:?}");
println(f"Y: {y_real:?}");
println(f"Model: y = 2x");
println(f"R² = {r_squared_real:.3f} ({r_squared_real * 100.0:.1f}% variance explained)");

// 3. Interpreting R-squared values
println("\n3. INTERPRETING R² Values:");
println("   R² = 1.00 (100%): Perfect fit - all variance explained");
println("   R² = 0.90 (90%): Excellent fit");
println("   R² = 0.70 (70%): Good fit");
println("   R² = 0.50 (50%): Moderate fit");
println("   R² = 0.30 (30%): Weak fit");
println("   R² = 0.00 (0%): No better than mean");

// 4. Real-world: Study hours vs Test score
println("\n4. Real-World: Study Hours vs Test Score");

let study_hours = [2, 3, 4, 5, 6, 7, 8];
let test_scores = [55, 60, 70, 75, 80, 85, 90];

// Calculate regression line
let n = study_hours.len();
let sum_x = study_hours.sum();
let sum_y = test_scores.sum();
let sum_xy = study_hours.iter().zip(test_scores.iter()).map(|(x, y)| x * y).sum();
let sum_x_sq = study_hours.iter().map(|x| x * x).sum();

let slope = ((n * sum_xy) - (sum_x * sum_y)) / ((n * sum_x_sq) - (sum_x * sum_x));
let intercept = (sum_y - (slope * sum_x)) / n;

// Calculate R²
let mean_score = test_scores.sum() / test_scores.len();

let mut ss_tot = 0.0;
let mut ss_res = 0.0;

for i in 0..study_hours.len() {
    let y_pred = slope * study_hours[i] + intercept;
    ss_tot = ss_tot + ((test_scores[i] - mean_score) * (test_scores[i] - mean_score));
    ss_res = ss_res + ((test_scores[i] - y_pred) * (test_scores[i] - y_pred));
}

let r_squared_study = 1.0 - (ss_res / ss_tot);

println(f"\nStudy hours: {study_hours:?}");
println(f"Test scores: {test_scores:?}");
println(f"Regression: score = {slope:.2f} × hours + {intercept:.1f}");
println(f"R² = {r_squared_study:.3f}");
println(f"\n💡 Interpretation:");
println(f"  {r_squared_study * 100.0:.1f}% of test score variation explained by study hours");
println(f"  {(1.0 - r_squared_study) * 100.0:.1f}% due to other factors (ability, sleep, etc.)");

// 5. Baseline comparison - Mean model
println("\n5. BASELINE: Mean Model (No Predictors)");

let sales_actual = [100, 120, 110, 130, 140, 125, 135];
let sales_mean = sales_actual.sum() / sales_actual.len();

// Mean model always predicts mean
let mut ss_tot_sales = 0.0;
for sale in sales_actual {
    ss_tot_sales = ss_tot_sales + ((sale - sales_mean) * (sale - sales_mean));
}

println(f"\nActual sales: {sales_actual:?}");
println(f"Mean model: Always predict {sales_mean}");
println(f"SS_tot: {ss_tot_sales:.0f}");
println("\nThis is the baseline - R² of any model compares against this!");

// 6. Adjusted R-squared
println("\n6. ADJUSTED R²: Accounting for Model Complexity");
println("   Formula: R²_adj = 1 - [(1-R²)(n-1)/(n-p-1)]");
println("   n = sample size, p = number of predictors");
println("   Penalizes adding unnecessary predictors");

let n_samples = 50;
let n_predictors = 3;
let r_sq = 0.85;

let adj_r_sq = 1.0 - ((1.0 - r_sq) * (n_samples - 1) / (n_samples - n_predictors - 1));

println(f"\nModel with {n_predictors} predictors:");
println(f"  Sample size: {n_samples}");
println(f"  R²: {r_sq:.3f}");
println(f"  Adjusted R²: {adj_r_sq:.3f}");
println("\nAdjusted R² slightly lower - accounts for model complexity");

// 7. When R² is misleading
println("\n7. When R² is MISLEADING:");
println("\n⚠ HIGH R² but BAD model:");
println("  • Overfitting (too many features)");
println("  • Outliers driving the fit");
println("  • Non-linear relationship");
println("  • Spurious correlation");

println("\n⚠ LOW R² but USEFUL model:");
println("  • Inherently noisy data (human behavior)");
println("  • Small but significant effect");
println("  • Predicting rare events");
println("  Example: R²=0.20 in social sciences can be meaningful!");

// 8. Model comparison
println("\n8. MODEL COMPARISON using R²:");

// Model 1: Simple (price only)
let house_price = [200, 250, 300, 350, 400];
let sqft_only = [1500, 1800, 2100, 2400, 2700];

let price_mean = house_price.sum() / house_price.len();

// Simple linear fit
let mut ss_tot_model1 = 0.0;
let mut ss_res_model1 = 0.0;

for i in 0..house_price.len() {
    let predicted = 100.0 + (0.1 * sqft_only[i]); // Simplified model
    ss_tot_model1 = ss_tot_model1 + ((house_price[i] - price_mean) * (house_price[i] - price_mean));
    ss_res_model1 = ss_res_model1 + ((house_price[i] - predicted) * (house_price[i] - predicted));
}

let r_sq_model1 = 1.0 - (ss_res_model1 / ss_tot_model1);

println(f"\nModel 1 (SqFt only):");
println(f"  R² = {r_sq_model1:.3f}");

// Model 2 would add bedrooms, location, etc. and likely improve R²
println("\nModel 2 (SqFt + Bedrooms + Location):");
println("  R² = 0.920 (example)");
println("\n📊 Model 2 better explains house prices!");
println("   Higher R² = Better predictive power");

println("\n✅ R-Squared Complete!");
println("\n📚 Key Takeaways:");
println("• R²: Proportion of variance explained");
println("• Range: 0 (no fit) to 1 (perfect fit)");
println("• Compares model to baseline (mean)");
println("• Higher R² = Better model fit");
println("• Use Adjusted R² for multiple predictors");
println("• Context matters - 0.20 can be good in some fields!");
println("\n🎯 Applications:");
println("  ✓ Model selection");
println("  ✓ Regression diagnostics");
println("  ✓ Feature importance");
println("  ✓ Communicating model quality");
