// Statistical Demo 8: Covariance - Measuring Joint Variability
// Concepts: Covariance, joint variation, correlation foundation
// Use cases: Portfolio theory, feature relationships, multivariate analysis

println("=== Covariance: Measuring How Variables Change Together ===\n");

// 1. Covariance Basics
println("1. COVARIANCE:");
println("   Formula: Σ(xi - x̄)(yi - ȳ) / n");
println("   Measures: How two variables vary together");

let x = [1, 2, 3, 4, 5];
let y = [2, 4, 6, 8, 10];

let mean_x = x.sum() / x.len();
let mean_y = y.sum() / y.len();

let mut cov = 0.0;
for i in 0..x.len() {
    cov = cov + ((x[i] - mean_x) * (y[i] - mean_y));
}
cov = cov / x.len();

println(f"\nX: {x:?}");
println(f"Y: {y:?}");
println(f"Mean X: {mean_x}, Mean Y: {mean_y}");
println(f"Covariance: {cov:.2f}");

// 2. Positive vs Negative Covariance
println("\n2. POSITIVE vs NEGATIVE Covariance:");

// Positive covariance
let study_hours = [2, 3, 4, 5, 6];
let test_scores = [60, 70, 75, 85, 90];

let mean_study = study_hours.sum() / study_hours.len();
let mean_score = test_scores.sum() / test_scores.len();

let mut cov_pos = 0.0;
for i in 0..study_hours.len() {
    cov_pos = cov_pos + ((study_hours[i] - mean_study) * (test_scores[i] - mean_score));
}
cov_pos = cov_pos / study_hours.len();

println(f"\nStudy hours: {study_hours:?}");
println(f"Test scores: {test_scores:?}");
println(f"Covariance: {cov_pos:.2f}");
println("Positive covariance: More study → Higher scores");

// Negative covariance
let price = [10, 15, 20, 25, 30];
let demand = [100, 80, 60, 40, 20];

let mean_price = price.sum() / price.len();
let mean_demand = demand.sum() / demand.len();

let mut cov_neg = 0.0;
for i in 0..price.len() {
    cov_neg = cov_neg + ((price[i] - mean_price) * (demand[i] - mean_demand));
}
cov_neg = cov_neg / price.len();

println(f"\nPrice: {price:?}");
println(f"Demand: {demand:?}");
println(f"Covariance: {cov_neg:.2f}");
println("Negative covariance: Higher price → Lower demand");

// 3. Covariance vs Correlation
println("\n3. COVARIANCE vs CORRELATION:");
println("   Covariance: Unbounded (can be any value)");
println("   Correlation: Bounded [-1, +1]");
println("   Relationship: Correlation = Cov(X,Y) / (σX × σY)");

let data_x = [10, 20, 30, 40, 50];
let data_y = [15, 25, 35, 45, 55];

let dx_mean = data_x.sum() / data_x.len();
let dy_mean = data_y.sum() / data_y.len();

// Covariance
let mut covariance = 0.0;
for i in 0..data_x.len() {
    covariance = covariance + ((data_x[i] - dx_mean) * (data_y[i] - dy_mean));
}
covariance = covariance / data_x.len();

// Standard deviations
let var_x = data_x.map(|x| (x - dx_mean) * (x - dx_mean)).sum() / data_x.len();
let var_y = data_y.map(|y| (y - dy_mean) * (y - dy_mean)).sum() / data_y.len();
let std_x = var_x.sqrt();
let std_y = var_y.sqrt();

// Correlation
let correlation = covariance / (std_x * std_y);

println(f"\nX: {data_x:?}");
println(f"Y: {data_y:?}");
println(f"Covariance: {covariance:.2f} (unbounded)");
println(f"Correlation: {correlation:.3f} (bounded [-1,1])");
println("Correlation is standardized covariance!");

// 4. Portfolio Theory Application
println("\n4. Real-World: Portfolio Diversification");

// Stock returns over 5 months (%)
let stock_a = [5, -2, 8, 3, -1];
let stock_b = [3, 6, -4, 2, 7];

let mean_a = stock_a.sum() / stock_a.len();
let mean_b = stock_b.sum() / stock_b.len();

let mut cov_stocks = 0.0;
for i in 0..stock_a.len() {
    cov_stocks = cov_stocks + ((stock_a[i] - mean_a) * (stock_b[i] - mean_b));
}
cov_stocks = cov_stocks / stock_a.len();

println(f"\nStock A returns: {stock_a:?}%");
println(f"Stock B returns: {stock_b:?}%");
println(f"Covariance: {cov_stocks:.2f}");

if cov_stocks < 0.0 {
    println("\n💰 Investment insight:");
    println("  Negative covariance → Good diversification!");
    println("  When A falls, B tends to rise (hedging)");
    println("  Reduces portfolio risk");
} else if cov_stocks > 0.0 {
    println("\n⚠ Investment insight:");
    println("  Positive covariance → Move together");
    println("  Limited diversification benefit");
} else {
    println("  Zero covariance → Independent movements");
}

// 5. Sample vs Population Covariance
println("\n5. SAMPLE vs POPULATION Covariance:");
println("   Population: Divide by n");
println("   Sample: Divide by (n-1) - Bessel's correction");

let sample_x = [10, 15, 20, 25];
let sample_y = [12, 18, 22, 28];

let sx_mean = sample_x.sum() / sample_x.len();
let sy_mean = sample_y.sum() / sample_y.len();

let mut pop_cov = 0.0;
for i in 0..sample_x.len() {
    pop_cov = pop_cov + ((sample_x[i] - sx_mean) * (sample_y[i] - sy_mean));
}
pop_cov = pop_cov / sample_x.len();

let sample_cov = pop_cov * sample_x.len() / (sample_x.len() - 1);

println(f"\nData X: {sample_x:?}");
println(f"Data Y: {sample_y:?}");
println(f"Population cov (÷n): {pop_cov:.2f}");
println(f"Sample cov (÷n-1): {sample_cov:.2f}");
println("Use sample covariance when estimating from sample!");

// 6. Covariance Matrix
println("\n6. COVARIANCE MATRIX (Multiple Variables):");

let var1 = [10, 20, 30];
let var2 = [15, 25, 35];
let var3 = [12, 22, 32];

println(f"\nVariable 1: {var1:?}");
println(f"Variable 2: {var2:?}");
println(f"Variable 3: {var3:?}");

println("\nCovariance matrix:");
println("           Var1  Var2  Var3");
println("  Var1 [ Var(1) Cov(1,2) Cov(1,3) ]");
println("  Var2 [ Cov(2,1) Var(2) Cov(2,3) ]");
println("  Var3 [ Cov(3,1) Cov(3,2) Var(3) ]");
println("\nDiagonal: Variances of each variable");
println("Off-diagonal: Covariances between variables");

// 7. Properties of Covariance
println("\n7. PROPERTIES of Covariance:");
println("   • Cov(X,X) = Var(X)");
println("   • Cov(X,Y) = Cov(Y,X) (symmetric)");
println("   • Cov(aX,bY) = ab·Cov(X,Y) (scaling)");
println("   • If X,Y independent → Cov(X,Y) = 0");
println("   • Cov(X,Y) = 0 does NOT imply independence!");

println("\n✅ Covariance Complete!");
println("\n📚 Key Takeaways:");
println("• Covariance: Measures joint variability");
println("• Positive: Variables increase together");
println("• Negative: One increases, other decreases");
println("• Zero: No linear relationship");
println("• Scale-dependent (unlike correlation)");
println("\n🎯 Applications:");
println("  ✓ Portfolio risk management");
println("  ✓ Multivariate statistics");
println("  ✓ Principal Component Analysis (PCA)");
println("  ✓ Feature engineering");
