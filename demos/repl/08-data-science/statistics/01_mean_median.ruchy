// Statistical Demo 1: Mean and Median - Central Tendency Measures
// Concepts: Average, median, central tendency, data distribution
// Use cases: Summarizing datasets, understanding typical values

println("=== Mean and Median: Measuring Central Tendency ===\n");

// 1. Mean (Average) - Sum divided by count
println("1. MEAN (Average):");
println("   Formula: sum(values) / count(values)");

let dataset1 = [10, 20, 30, 40, 50];
let sum1 = dataset1.sum();
let count1 = dataset1.len();
let mean1 = sum1 / count1;

println(f"\nDataset: {dataset1:?}");
println(f"Sum: {sum1}");
println(f"Count: {count1}");
println(f"Mean: {mean1}");

// 2. Mean with functional approach
println("\n2. Mean with Functional Programming:");
let ages = [25, 30, 28, 35, 42, 29, 31];
let mean_age = ages.sum() / ages.len();
println(f"Ages: {ages:?}");
println(f"Average age: {mean_age:.1f} years");

// 3. Median - Middle value when sorted
println("\n3. MEDIAN (Middle Value):");
println("   Process: Sort data, find middle value(s)");

let scores = [85, 92, 78, 95, 88];
let sorted_scores = scores.sorted();
let n = sorted_scores.len();
let median = if n % 2 == 1 {
    // Odd count: take middle element
    sorted_scores[n / 2]
} else {
    // Even count: average two middle elements
    (sorted_scores[n / 2 - 1] + sorted_scores[n / 2]) / 2
};

println(f"\nOriginal scores: {scores:?}");
println(f"Sorted scores: {sorted_scores:?}");
println(f"Median score: {median}");

// 4. Mean vs Median with Outliers
println("\n4. Mean vs Median with OUTLIERS:");
println("   Key insight: Median is resistant to outliers");

let salaries = [45000, 48000, 50000, 52000, 55000];
let mean_salary = salaries.sum() / salaries.len();
let sorted_salaries = salaries.sorted();
let median_salary = sorted_salaries[sorted_salaries.len() / 2];

println(f"\nNormal salary data: {salaries:?}");
println(f"Mean salary: ${mean_salary}");
println(f"Median salary: ${median_salary}");

// Add CEO outlier
let salaries_with_outlier = [45000, 48000, 50000, 52000, 55000, 500000];
let mean_with_outlier = salaries_with_outlier.sum() / salaries_with_outlier.len();
let sorted_with_outlier = salaries_with_outlier.sorted();
let n_outlier = sorted_with_outlier.len();
let median_with_outlier = (sorted_with_outlier[n_outlier / 2 - 1] + sorted_with_outlier[n_outlier / 2]) / 2;

println(f"\nWith CEO outlier: {salaries_with_outlier:?}");
println(f"Mean salary: ${mean_with_outlier} (DISTORTED by outlier!)");
println(f"Median salary: ${median_with_outlier} (ROBUST to outlier)");

let mean_change = mean_with_outlier - mean_salary;
let median_change = median_with_outlier - median_salary;
println(f"\nImpact of outlier:");
println(f"  Mean changed by: ${mean_change} ({(mean_change * 100 / mean_salary):.0f}% increase)");
println(f"  Median changed by: ${median_change} ({(median_change * 100 / median_salary):.0f}% increase)");

// 5. Real-world application: Test scores
println("\n5. Real-World Example: Class Test Scores");

let class_scores = [78, 82, 75, 88, 92, 79, 85, 90, 73, 87];
let mean_score = class_scores.sum() / class_scores.len();
let sorted_class = class_scores.sorted();
let median_score = (sorted_class[sorted_class.len() / 2 - 1] + sorted_class[sorted_class.len() / 2]) / 2;

println(f"Class scores: {class_scores:?}");
println(f"Mean score: {mean_score:.1f}");
println(f"Median score: {median_score}");
println(f"\nInterpretation:");
println(f"  • Mean of {mean_score:.1f} represents overall class performance");
println(f"  • Median of {median_score} shows the typical student's score");
println(f"  • Close values indicate balanced distribution");

// 6. When to use each
println("\n6. WHEN TO USE EACH MEASURE:");
println("   MEAN:");
println("     ✓ Symmetric distributions (bell curve)");
println("     ✓ No significant outliers");
println("     ✓ When all values matter equally");
println("     Example: Average test scores, heights, temperatures");
println("\n   MEDIAN:");
println("     ✓ Skewed distributions");
println("     ✓ Data with outliers");
println("     ✓ Income/salary data");
println("     Example: House prices, income, age distributions");

println("\n✅ Mean and Median Complete!");
println("\n📚 Key Takeaways:");
println("• Mean: Best for symmetric data without outliers");
println("• Median: Robust to outliers and skewed distributions");
println("• Always compare both to understand your data");
println("• Large difference between mean and median → outliers present");
