// Statistical Demo 5: Linear Regression - Prediction and Modeling
// Concepts: Linear regression, slope, intercept, predictions, residuals
// Use cases: Forecasting, trend analysis, predictive modeling

println("=== Linear Regression: Building Predictive Models ===\n");

// 1. Simple Linear Regression - Finding the line of best fit
println("1. SIMPLE LINEAR REGRESSION:");
println("   Formula: y = mx + b");
println("   m = slope, b = y-intercept");
println("   Goal: Find line that best fits the data");

let x = [1, 2, 3, 4, 5];
let y = [2, 4, 5, 4, 5];

let n = x.len();
let sum_x = x.sum();
let sum_y = y.sum();
let sum_xy = x.iter().zip(y.iter()).map(|(xi, yi)| xi * yi).sum();
let sum_x_sq = x.iter().map(|xi| xi * xi).sum();

// Calculate slope (m) and intercept (b)
let slope = ((n * sum_xy) - (sum_x * sum_y)) / ((n * sum_x_sq) - (sum_x * sum_x));
let intercept = (sum_y - (slope * sum_x)) / n;

println(f"\nData:");
println(f"X: {x:?}");
println(f"Y: {y:?}");
println(f"\nRegression line: y = {slope:.2f}x + {intercept:.2f}");

// 2. Making Predictions
println("\n2. MAKING PREDICTIONS:");

// Predict for new values
let x_new1 = 6;
let y_pred1 = slope * x_new1 + intercept;
let x_new2 = 10;
let y_pred2 = slope * x_new2 + intercept;

println(f"Predict when x = {x_new1}: y = {y_pred1:.2f}");
println(f"Predict when x = {x_new2}: y = {y_pred2:.2f}");
println("\nThis is INTERPOLATION (within data range)");
println("Or EXTRAPOLATION (beyond data range)");

// 3. Model Evaluation - Residuals
println("\n3. MODEL EVALUATION: Residuals");
println("   Residual = Actual - Predicted");
println("   Measures: How far off our predictions are");

let mut residuals = [];
let mut sum_residuals_sq = 0.0;

println(f"\nPredictions vs Actual:");
for i in 0..x.len() {
    let y_pred = slope * x[i] + intercept;
    let residual = y[i] - y_pred;
    residuals.push(residual);
    sum_residuals_sq = sum_residuals_sq + (residual * residual);
    println(f"  x={x[i]}: predicted={y_pred:.2f}, actual={y[i]}, residual={residual:.2f}");
}

// Root Mean Squared Error (RMSE)
let rmse = (sum_residuals_sq / n).sqrt();
println(f"\nRMSE (Root Mean Squared Error): {rmse:.3f}");
println("Lower RMSE = Better model fit");

// 4. Real-world: Sales Forecasting
println("\n4. Real-World Example: Sales Forecasting");

let months = [1, 2, 3, 4, 5, 6];
let sales_k = [10, 12, 15, 17, 20, 22];

let n_sales = months.len();
let sum_months = months.sum();
let sum_sales = sales_k.sum();
let sum_month_sales = months.iter().zip(sales_k.iter()).map(|(m, s)| m * s).sum();
let sum_months_sq = months.iter().map(|m| m * m).sum();

let m_sales = ((n_sales * sum_month_sales) - (sum_months * sum_sales)) /
              ((n_sales * sum_months_sq) - (sum_months * sum_months));
let b_sales = (sum_sales - (m_sales * sum_months)) / n_sales;

println(f"\nHistorical data:");
println(f"Months: {months:?}");
println(f"Sales ($k): {sales_k:?}");
println(f"\nRegression: sales = {m_sales:.2f} × month + {b_sales:.2f}");

// Forecast next 3 months
println(f"\n📈 Sales Forecast:");
for month in 7..=9 {
    let forecast = m_sales * month + b_sales;
    println(f"  Month {month}: ${forecast:.1f}k predicted");
}

println(f"\n💰 Growth rate: ${m_sales:.2f}k per month");

// 5. Multiple data points - House prices
println("\n5. Real-World: House Price Prediction");

let sqft = [1000, 1200, 1500, 1800, 2000, 2200, 2500];
let price_k = [150, 170, 200, 230, 250, 270, 300];

let n_houses = sqft.len();
let sum_sqft = sqft.sum();
let sum_price = price_k.sum();
let sum_sqft_price = sqft.iter().zip(price_k.iter()).map(|(s, p)| s * p).sum();
let sum_sqft_sq = sqft.iter().map(|s| s * s).sum();

let m_price = ((n_houses * sum_sqft_price) - (sum_sqft * sum_price)) /
              ((n_houses * sum_sqft_sq) - (sum_sqft * sum_sqft));
let b_price = (sum_price - (m_price * sum_sqft)) / n_houses;

println(f"\nHouse data:");
println(f"Square feet: {sqft:?}");
println(f"Price ($k): {price_k:?}");
println(f"\nModel: price = {m_price:.3f} × sqft + {b_price:.1f}");
println(f"\nInterpretation:");
println(f"  • Base price: ${b_price:.1f}k");
println(f"  • Price per sqft: ${m_price:.3f}k = ${m_price * 1000:.2f}");

// Predict for 1750 sqft house
let target_sqft = 1750;
let predicted_price = m_price * target_sqft + b_price;
println(f"\nPredict 1750 sqft house: ${predicted_price:.1f}k");

// 6. R-squared - Goodness of fit
println("\n6. R-SQUARED: Model Quality");

let mean_price_k = sum_price / n_houses;

let mut ss_tot = 0.0; // Total sum of squares
let mut ss_res = 0.0; // Residual sum of squares

for i in 0..n_houses {
    let y_pred = m_price * sqft[i] + b_price;
    ss_res = ss_res + ((price_k[i] - y_pred) * (price_k[i] - y_pred));
    ss_tot = ss_tot + ((price_k[i] - mean_price_k) * (price_k[i] - mean_price_k));
}

let r_squared = 1.0 - (ss_res / ss_tot);

println(f"R² = {r_squared:.3f}");
println(f"Interpretation: {r_squared * 100.0:.1f}% of price variance explained by sqft");

if r_squared > 0.9 {
    println("Excellent fit! Strong predictive power");
} else if r_squared > 0.7 {
    println("Good fit. Model explains most variance");
} else {
    println("Moderate fit. Consider additional features");
}

// 7. Assumptions and Limitations
println("\n7. ASSUMPTIONS of Linear Regression:");
println("   ✓ Linear relationship exists");
println("   ✓ Independent observations");
println("   ✓ Residuals are normally distributed");
println("   ✓ Constant variance (homoscedasticity)");
println("\n⚠ LIMITATIONS:");
println("   • Only captures linear relationships");
println("   • Sensitive to outliers");
println("   • Extrapolation can be unreliable");
println("   • Correlation ≠ causation");

// 8. When to use linear regression
println("\n8. WHEN TO USE Linear Regression:");

println("\n✓ GOOD USES:");
println("  • Trend forecasting (sales, growth)");
println("  • Price prediction (real estate, stocks)");
println("  • Resource planning (demand, capacity)");
println("  • Relationship quantification");

println("\n✗ BAD USES:");
println("  • Non-linear relationships (use polynomial/non-linear)");
println("  • Categorical outcomes (use logistic regression)");
println("  • Complex interactions (use ML algorithms)");

println("\n✅ Linear Regression Complete!");
println("\n📚 Key Takeaways:");
println("• Formula: y = mx + b (slope-intercept form)");
println("• Slope (m): Rate of change");
println("• Intercept (b): Y-value when x=0");
println("• RMSE: Measures prediction error");
println("• R²: Measures model fit (0-1 scale)");
println("• Simple, interpretable, foundational ML technique");
println("\n🎯 Next Steps:");
println("  • Try multiple linear regression (multiple predictors)");
println("  • Explore polynomial regression (curves)");
println("  • Learn regularization (Ridge, Lasso)");
