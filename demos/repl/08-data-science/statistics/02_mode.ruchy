// Statistical Demo 2: Mode - Most Frequent Value
// Concepts: Frequency distribution, categorical data, multimodal distributions
// Use cases: Finding most common values, categorical analysis

println("=== Mode: Finding the Most Frequent Value ===\n");

// 1. Basic Mode - Single most frequent value
println("1. BASIC MODE:");
println("   Definition: Value that appears most frequently");

let votes = [1, 2, 2, 3, 2, 4, 3, 2, 5];
println(f"\nVotes: {votes:?}");

// Count frequencies
let mut freq_map = {};
for vote in votes {
    freq_map[vote] = freq_map.get(vote).unwrap_or(0) + 1;
}

// Find mode
let mut mode = 0;
let mut max_freq = 0;
for (value, freq) in freq_map {
    if freq > max_freq {
        max_freq = freq;
        mode = value;
    }
}

println(f"Frequency distribution: {freq_map:?}");
println(f"Mode: {mode} (appears {max_freq} times)");

// 2. Mode with categorical data
println("\n2. Mode with CATEGORICAL DATA:");
println("   Perfect for: favorite colors, product categories, survey responses");

let favorite_colors = ["blue", "red", "blue", "green", "blue", "red", "blue", "yellow"];
println(f"\nFavorite colors: {favorite_colors:?}");

let mut color_counts = {};
for color in favorite_colors {
    color_counts[color] = color_counts.get(color).unwrap_or(0) + 1;
}

let mut mode_color = "";
let mut max_count = 0;
for (color, count) in color_counts {
    if count > max_count {
        max_count = count;
        mode_color = color;
    }
}

println(f"Color frequencies: {color_counts:?}");
println(f"Most popular color: {mode_color} ({max_count}/{favorite_colors.len()} people)");
let percentage = (max_count * 100) / favorite_colors.len();
println(f"Popularity: {percentage}% of respondents");

// 3. Bimodal Distribution - Two peaks
println("\n3. BIMODAL Distribution:");
println("   Two modes: Data has two equally frequent values");

let ages = [25, 25, 25, 30, 35, 45, 45, 45, 50];
println(f"\nAges: {ages:?}");

let mut age_freq = {};
for age in ages {
    age_freq[age] = age_freq.get(age).unwrap_or(0) + 1;
}

// Find all modes (handle ties)
let max_frequency = age_freq.values().max().unwrap_or(0);
let modes = age_freq.iter()
    .filter(|(_, freq)| freq == max_frequency)
    .map(|(age, _)| age)
    .collect::<Vec<_>>();

println(f"Age frequencies: {age_freq:?}");
println(f"Modes: {modes:?} (both appear {max_frequency} times)");
println("This is a BIMODAL distribution - suggests two distinct groups!");

// 4. Mode in discrete vs continuous data
println("\n4. Mode in DISCRETE vs CONTINUOUS Data:");

// Discrete data: Clear mode
let shoe_sizes = [7, 8, 8, 8, 9, 9, 10, 11];
let mut size_freq = {};
for size in shoe_sizes {
    size_freq[size] = size_freq.get(size).unwrap_or(0) + 1;
}
let mode_size = size_freq.iter()
    .max_by_key(|(_, freq)| freq)
    .map(|(size, _)| size)
    .unwrap_or(0);

println(f"\nShoe sizes (discrete): {shoe_sizes:?}");
println(f"Mode: Size {mode_size} (most common)");
println("✓ Mode works well with discrete data");

// Continuous data grouped into bins
let heights_cm = [165, 167, 170, 172, 168, 171, 169, 173, 166, 170];
// Group into 5cm bins
let bins = heights_cm.map(|h| (h / 5) * 5); // Round down to nearest 5cm
println(f"\nHeights (continuous): {heights_cm:?}");
println(f"Grouped into bins: {bins:?}");
println("⚠ Continuous data needs binning for mode to be meaningful");

// 5. Real-world application: Customer preferences
println("\n5. Real-World Example: Product Sizes Sold");

let sizes_sold = ["M", "L", "M", "S", "M", "L", "M", "XL", "M", "L", "M", "S", "M"];
println(f"\nSizes sold today: {sizes_sold:?}");

let mut size_count = {};
for size in sizes_sold {
    size_count[size] = size_count.get(size).unwrap_or(0) + 1;
}

let modal_size = size_count.iter()
    .max_by_key(|(_, count)| count)
    .map(|(size, count)| (size, count))
    .unwrap();

println(f"\nSize distribution: {size_count:?}");
println(f"Modal size: {modal_size.0} ({modal_size.1} units)");
println("\n💼 Business insight:");
println(f"   • Stock more size {modal_size.0} inventory");
println("   • This is your most common customer");
println("   • Plan manufacturing around modal demand");

// 6. No Mode case
println("\n6. NO MODE (All values equally frequent):");
let uniform_data = [10, 20, 30, 40, 50];
println(f"Data: {uniform_data:?}");
println("All values appear once - NO MODE");
println("This is a uniform distribution");

// 7. Mode vs Mean vs Median comparison
println("\n7. Mode vs Mean vs Median - When to Use:");

let exam_scores = [65, 70, 75, 75, 75, 80, 85, 90, 95];
let mode_score = 75; // appears 3 times
let mean_score = exam_scores.sum() / exam_scores.len();
let median_score = exam_scores[exam_scores.len() / 2];

println(f"\nExam scores: {exam_scores:?}");
println(f"Mode: {mode_score} (most common score)");
println(f"Mean: {mean_score} (average performance)");
println(f"Median: {median_score} (middle value)");

println("\n📊 Interpretation:");
println("• Mode tells us: Most students scored 75");
println("• Mean tells us: Overall class average");
println("• Median tells us: Typical middle performance");
println("• All three give different insights!");

println("\n✅ Mode Analysis Complete!");
println("\n📚 Key Takeaways:");
println("• Mode: Most frequent value in dataset");
println("• Perfect for categorical data (colors, sizes, preferences)");
println("• Can have multiple modes (bimodal, multimodal)");
println("• May have no mode (uniform distribution)");
println("• Essential for understanding popularity and frequency");
println("\n🎯 Use Mode When:");
println("  ✓ Analyzing categorical data");
println("  ✓ Finding most popular choice");
println("  ✓ Inventory/stock planning");
println("  ✓ Customer preference analysis");
