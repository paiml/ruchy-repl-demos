// Statistical Demo 10: Hypothesis Testing Basics - Statistical Significance
// Concepts: Null hypothesis, p-value, significance level, Type I/II errors
// Use cases: A/B testing, scientific experiments, decision making

println("=== Hypothesis Testing: Making Data-Driven Decisions ===\n");

// 1. Hypothesis Testing Framework
println("1. HYPOTHESIS TESTING Framework:");
println("   H₀ (Null): No effect, no difference, status quo");
println("   H₁ (Alternative): There is an effect, difference exists");
println("   Goal: Decide whether to reject H₀ based on data");

println("\nExample:");
println("  H₀: New drug has NO effect (mean = 0)");
println("  H₁: New drug HAS effect (mean ≠ 0)");

// 2. P-value concept
println("\n2. P-VALUE:");
println("   Definition: Probability of observing data this extreme");
println("               if null hypothesis were true");
println("   Small p-value → Strong evidence against H₀");

println("\n  p-value < 0.01: Very strong evidence (99% confident)");
println("  p-value < 0.05: Strong evidence (95% confident)");
println("  p-value < 0.10: Moderate evidence (90% confident)");
println("  p-value > 0.10: Weak evidence, don't reject H₀");

// 3. Significance Level (α)
println("\n3. SIGNIFICANCE LEVEL (α):");
println("   α = Threshold for rejecting H₀");
println("   Common: α = 0.05 (5% significance level)");
println("   Decision rule: If p-value < α, reject H₀");

let alpha = 0.05;
let p_value_1 = 0.03;
let p_value_2 = 0.08;

println(f"\nα = {alpha} (significance level)");
println(f"\nScenario 1: p-value = {p_value_1}");
if p_value_1 < alpha {
    println("  → p < α: REJECT H₀ (result is significant)");
} else {
    println("  → p > α: FAIL TO REJECT H₀");
}

println(f"\nScenario 2: p-value = {p_value_2}");
if p_value_2 < alpha {
    println("  → p < α: REJECT H₀");
} else {
    println("  → p > α: FAIL TO REJECT H₀ (not significant)");
}

// 4. Z-test example (comparing to known mean)
println("\n4. Z-TEST: Comparing Sample Mean to Population");

// Is this class's average different from national average?
let national_avg = 75;
let national_std = 10.0;
let class_scores = [78, 82, 85, 79, 88, 76, 84, 80];

let class_mean = class_scores.sum() / class_scores.len();
let n = class_scores.len();

// Calculate z-statistic
let z_stat = (class_mean - national_avg) / (national_std / (n as f64).sqrt());

println(f"\nNational average: {national_avg}");
println(f"Class scores: {class_scores:?}");
println(f"Class average: {class_mean}");
println(f"Sample size: {n}");
println(f"\nZ-statistic: {z_stat:.2f}");

// Rough p-value interpretation (simplified)
let p_approx = if z_stat.abs() > 2.58 {
    0.01 // 99% confidence
} else if z_stat.abs() > 1.96 {
    0.05 // 95% confidence
} else if z_stat.abs() > 1.64 {
    0.10 // 90% confidence
} else {
    0.20 // Not significant
};

println(f"Approximate p-value: {p_approx}");

if p_approx < 0.05 {
    println("\n✓ Significant! Class performs differently than national average");
} else {
    println("\n✗ Not significant. Difference could be due to chance");
}

// 5. Type I and Type II Errors
println("\n5. TYPE I and TYPE II Errors:");
println("\n  Type I Error (False Positive):");
println("    • Reject H₀ when it's actually true");
println("    • Probability = α (significance level)");
println("    • Example: Say drug works when it doesn't");

println("\n  Type II Error (False Negative):");
println("    • Fail to reject H₀ when it's false");
println("    • Probability = β");
println("    • Example: Say drug doesn't work when it does");

println("\n  Trade-off:");
println("    Lower α (stricter) → Fewer Type I, More Type II");
println("    Higher α (lenient) → More Type I, Fewer Type II");

// 6. Real-world: A/B Testing
println("\n6. Real-World: A/B Testing (Website Conversion)");

// Version A (control)
let conversions_a = 45;
let visitors_a = 500;
let rate_a = conversions_a / visitors_a;

// Version B (variant)
let conversions_b = 58;
let visitors_b = 500;
let rate_b = conversions_b / visitors_b;

let rate_diff = rate_b - rate_a;
let lift_pct = (rate_diff / rate_a) * 100.0;

println(f"\nVersion A (Control):");
println(f"  {conversions_a}/{visitors_a} converted = {rate_a * 100.0:.1f}% conversion");

println(f"\nVersion B (Variant):");
println(f"  {conversions_b}/{visitors_b} converted = {rate_b * 100.0:.1f}% conversion");

println(f"\n📊 Results:");
println(f"  Absolute difference: {rate_diff * 100.0:.1f} percentage points");
println(f"  Relative lift: {lift_pct:.1f}%");

// Simplified significance check
let pooled_rate = (conversions_a + conversions_b) / (visitors_a + visitors_b);
let se = ((pooled_rate * (1.0 - pooled_rate)) * (1.0/visitors_a + 1.0/visitors_b)).sqrt();
let z_ab = (rate_b - rate_a) / se;

println(f"\nZ-statistic: {z_ab:.2f}");

if z_ab.abs() > 1.96 {
    println("✓ SIGNIFICANT (p < 0.05)");
    println("  Implement Version B!");
} else {
    println("✗ NOT SIGNIFICANT");
    println("  Keep testing or stick with A");
}

// 7. Effect Size vs Statistical Significance
println("\n7. EFFECT SIZE vs Statistical Significance:");
println("\n  Statistical Significance (p-value):");
println("    • Is the effect real? (not due to chance)");
println("    • Depends on sample size");
println("    • Can be significant but tiny with large n");

println("\n  Effect Size:");
println("    • How large is the effect?");
println("    • Independent of sample size");
println("    • More important for practical decisions");

// Example: Large sample, small effect
let large_n_a = 10000;
let large_n_b = 10000;
let rate_large_a = 0.100; // 10.0%
let rate_large_b = 0.102; // 10.2%

println(f"\nLarge sample A/B test:");
println(f"  Version A: {rate_large_a * 100.0}% ({large_n_a} visitors)");
println(f"  Version B: {rate_large_b * 100.0}% ({large_n_b} visitors)");
println(f"  Difference: Only 0.2 percentage points");
println("\n  Likely SIGNIFICANT (large n)");
println("  But TINY effect - may not be worth implementing!");

// 8. Power Analysis
println("\n8. POWER ANALYSIS:");
println("   Power = 1 - β (probability of detecting real effect)");
println("   Common target: 80% power");

println("\n  Factors affecting power:");
println("    ↑ Sample size → ↑ Power");
println("    ↑ Effect size → ↑ Power");
println("    ↑ Significance level (α) → ↑ Power");
println("    ↓ Noise/variance → ↑ Power");

// 9. Common pitfalls
println("\n9. COMMON PITFALLS:");
println("\n  ⚠ P-hacking: Testing multiple hypotheses until one is significant");
println("  ⚠ HARKing: Hypothesizing After Results are Known");
println("  ⚠ Stopping early: Peeking at results and stopping when significant");
println("  ⚠ Ignoring effect size: Significant ≠ Important");
println("  ⚠ Confusing practical vs statistical significance");

// 10. Best Practices
println("\n10. BEST PRACTICES:");
println("\n  ✓ Pre-register hypothesis before collecting data");
println("  ✓ Choose α and sample size before experiment");
println("  ✓ Report both p-value AND effect size");
println("  ✓ Use confidence intervals");
println("  ✓ Consider practical significance");
println("  ✓ Replicate important findings");
println("  ✓ Be transparent about multiple testing");

// 11. When to use hypothesis testing
println("\n11. WHEN TO USE Hypothesis Testing:");

println("\n✓ GOOD USES:");
println("  • A/B testing (conversion, engagement)");
println("  • Clinical trials (drug efficacy)");
println("  • Quality control (defect rates)");
println("  • Scientific experiments");

println("\n✗ LIMITATIONS:");
println("  • Doesn't tell you WHY effect exists");
println("  • Binary decision (significant or not)");
println("  • Can't prove null hypothesis true");
println("  • Requires independence assumption");

println("\n✅ Hypothesis Testing Complete!");
println("\n📚 Key Takeaways:");
println("• H₀: Null hypothesis (no effect)");
println("• H₁: Alternative hypothesis (effect exists)");
println("• p-value: Evidence against H₀");
println("• α = 0.05: Common significance threshold");
println("• Reject H₀ when p < α");
println("• Consider both significance AND effect size");
println("• Beware Type I (false positive) and Type II (false negative) errors");
println("\n🎯 Real-World Applications:");
println("  ✓ A/B testing");
println("  ✓ Clinical trials");
println("  ✓ Quality assurance");
println("  ✓ Marketing experiments");
println("  ✓ Scientific research");
