// Visualization Prep Demo 1: Data Aggregation for Plotting
// Concepts: Aggregation, grouping, summarizing for charts
// Use cases: Bar charts, line plots, preparing visualization data

println("=== Data Aggregation for Visualization ===\n");

// 1. Bar Chart Data - Category counts
println("1. BAR CHART: Category Counts");

let purchases = [
    {category: "Electronics", amount: 1200},
    {category: "Books", amount: 45},
    {category: "Electronics", amount: 300},
    {category: "Clothing", amount: 80},
    {category: "Books", amount: 30},
    {category: "Electronics", amount: 150},
    {category: "Clothing", amount: 120}
];

// Aggregate by category
let mut electronics_count = 0;
let mut books_count = 0;
let mut clothing_count = 0;

for p in purchases {
    if p.category == "Electronics" { electronics_count = electronics_count + 1; }
    else if p.category == "Books" { books_count = books_count + 1; }
    else if p.category == "Clothing" { clothing_count = clothing_count + 1; }
}

println("\n📊 Bar Chart Data (Purchase Counts):");
println(f"  Electronics: {electronics_count} purchases");
println(f"  Books: {books_count} purchases");
println(f"  Clothing: {clothing_count} purchases");

println("\n  Visual representation:");
println(f"  Electronics: {'█' * electronics_count}");
println(f"  Books:       {'█' * books_count}");
println(f"  Clothing:    {'█' * clothing_count}");

// 2. Bar Chart Data - Category sums
println("\n2. BAR CHART: Revenue by Category");

let mut electronics_revenue = 0;
let mut books_revenue = 0;
let mut clothing_revenue = 0;

for p in purchases {
    if p.category == "Electronics" { electronics_revenue = electronics_revenue + p.amount; }
    else if p.category == "Books" { books_revenue = books_revenue + p.amount; }
    else if p.category == "Clothing" { clothing_revenue = clothing_revenue + p.amount; }
}

println("\n💰 Revenue by Category:");
println(f"  Electronics: ${electronics_revenue}");
println(f"  Books: ${books_revenue}");
println(f"  Clothing: ${clothing_revenue}");

let total_revenue = electronics_revenue + books_revenue + clothing_revenue;
let elec_pct = (electronics_revenue * 100) / total_revenue;
let book_pct = (books_revenue * 100) / total_revenue;
let cloth_pct = (clothing_revenue * 100) / total_revenue;

println("\n📈 Percentage breakdown:");
println(f"  Electronics: {elec_pct}%");
println(f"  Books: {book_pct}%");
println(f"  Clothing: {cloth_pct}%");

// 3. Line Plot Data - Time series aggregation
println("\n3. LINE PLOT: Sales Over Time");

let daily_sales = [
    {day: 1, sales: 100},
    {day: 2, sales: 150},
    {day: 3, sales: 120},
    {day: 4, sales: 180},
    {day: 5, sales: 200},
    {day: 6, sales: 170},
    {day: 7, sales: 220}
];

println("\n📉 Daily sales trend:");
for sale in daily_sales {
    let bars = sale.sales / 20;  // Scale for display
    println(f"  Day {sale.day}: ${sale.sales:3} {'█' * bars}");
}

// Calculate trend
let first_half = (daily_sales[0].sales + daily_sales[1].sales + daily_sales[2].sales) / 3;
let second_half = (daily_sales[4].sales + daily_sales[5].sales + daily_sales[6].sales) / 3;
let trend = if second_half > first_half { "↗ Increasing" } else { "↘ Decreasing" };

println(f"\nTrend: {trend} (${first_half} → ${second_half})");

// 4. Scatter Plot Data - Two variables
println("\n4. SCATTER PLOT: Study Hours vs Score");

let students = [
    {hours: 2, score: 65},
    {hours: 4, score: 75},
    {hours: 6, score: 85},
    {hours: 8, score: 90},
    {hours: 3, score: 70},
    {hours: 7, score: 88}
];

println("\n📊 Scatter plot data points:");
println("   Hours  Score");
for s in students {
    println(f"   {s.hours}      {s.score}");
}

// Show correlation
println("\n✓ Positive correlation visible");
println("  More hours → Higher scores");

// 5. Grouped Bar Chart - Multiple series
println("\n5. GROUPED BAR: Sales by Region and Product");

let regional_sales = [
    {region: "North", product: "A", sales: 100},
    {region: "North", product: "B", sales: 150},
    {region: "South", product: "A", sales: 120},
    {region: "South", product: "B", sales: 180}
];

println("\n📊 Sales by Region:");
println("         Product A  Product B");

let mut north_a = 0;
let mut north_b = 0;
let mut south_a = 0;
let mut south_b = 0;

for sale in regional_sales {
    if sale.region == "North" && sale.product == "A" { north_a = sale.sales; }
    else if sale.region == "North" && sale.product == "B" { north_b = sale.sales; }
    else if sale.region == "South" && sale.product == "A" { south_a = sale.sales; }
    else if sale.region == "South" && sale.product == "B" { south_b = sale.sales; }
}

println(f"North    ${north_a}        ${north_b}");
println(f"South    ${south_a}        ${south_b}");

// 6. Pie Chart Data - Percentages
println("\n6. PIE CHART: Market Share");

let market_share = [
    {company: "A", share: 35},
    {company: "B", share: 25},
    {company: "C", share: 20},
    {company: "D", share: 15},
    {company: "E", share: 5}
];

println("\n🥧 Market share distribution:");
let mut total = 0;
for m in market_share { total = total + m.share; }

for m in market_share {
    let bars = m.share / 5;
    println(f"  Company {m.company}: {m.share}% {'█' * bars}");
}

println("\n✅ Aggregation for Plots Complete!");
println("\n📚 Chart types and their data:");
println("  • Bar: Categories + counts/sums");
println("  • Line: Time series or ordered data");
println("  • Scatter: Two continuous variables");
println("  • Pie: Parts of a whole (percentages)");
println("  • Grouped bar: Multiple series per category");
println("\n🎯 Key steps:");
println("  1. Aggregate raw data");
println("  2. Calculate summaries");
println("  3. Format for chart library");
println("  4. Add labels and metadata");
