// Visualization Prep Demo 4: Binning and Histogram Data
// Concepts: Binning, frequency distributions, histograms
// Use cases: Distribution analysis, histogram charts, density plots

println("=== Binning and Histogram Preparation ===\n");

// 1. Basic Binning - Equal width
println("1. EQUAL WIDTH BINNING:");

let ages = [22, 25, 28, 32, 35, 38, 42, 45, 48, 52, 55, 58];
println(f"\nAges: {ages:?}");

// Bins: [20-30), [30-40), [40-50), [50-60)
let mut bin_20_30 = 0;
let mut bin_30_40 = 0;
let mut bin_40_50 = 0;
let mut bin_50_60 = 0;

for age in ages {
    if age >= 20 && age < 30 { bin_20_30 = bin_20_30 + 1; }
    else if age >= 30 && age < 40 { bin_30_40 = bin_30_40 + 1; }
    else if age >= 40 && age < 50 { bin_40_50 = bin_40_50 + 1; }
    else if age >= 50 && age < 60 { bin_50_60 = bin_50_60 + 1; }
}

println("\n📊 Histogram bins:");
println(f"  20-30: {bin_20_30} {'█' * bin_20_30}");
println(f"  30-40: {bin_30_40} {'█' * bin_30_40}");
println(f"  40-50: {bin_40_50} {'█' * bin_40_50}");
println(f"  50-60: {bin_50_60} {'█' * bin_50_60}");

// 2. Custom Bin Edges
println("\n2. CUSTOM BIN EDGES:");

let salaries = [35000, 42000, 58000, 75000, 95000, 48000, 62000, 88000];
println(f"\nSalaries: {salaries:?}");

// Custom bins: <50k, 50-75k, 75-100k
let mut low = 0;
let mut mid = 0;
let mut high = 0;

for salary in salaries {
    if salary < 50000 { low = low + 1; }
    else if salary < 75000 { mid = mid + 1; }
    else { high = high + 1; }
}

println("\n💰 Salary distribution:");
println(f"  <$50k:     {low} {'█' * (low * 3)}");
println(f"  $50-75k:   {mid} {'█' * (mid * 3)}");
println(f"  $75k+:     {high} {'█' * (high * 3)}");

let total = low + mid + high;
println(f"\nPercentages:");
println(f"  Low: {(low * 100) / total}%");
println(f"  Mid: {(mid * 100) / total}%");
println(f"  High: {(high * 100) / total}%");

// 3. Finding Optimal Bin Count
println("\n3. BIN COUNT SELECTION:");

let data = [10, 12, 15, 18, 20, 22, 25, 28, 30, 32, 35, 38, 40];
let n = data.len();

// Sturges' rule: bins = ceil(log2(n)) + 1
let bins_sturges = 5;  // Approx for n=13

// Square root choice: bins = ceil(sqrt(n))
let bins_sqrt = 4;  // Approx for n=13

println(f"\nDataset size: {n}");
println(f"Sturges' rule: ~{bins_sturges} bins");
println(f"Square root: ~{bins_sqrt} bins");
println("\n✓ More bins: Detailed but noisy");
println("✓ Fewer bins: Smooth but less detail");

// 4. Frequency Distribution
println("\n4. FREQUENCY DISTRIBUTION:");

let test_scores = [65, 72, 68, 85, 90, 78, 82, 75, 88, 92, 70, 84];
println(f"\nTest scores: {test_scores:?}");

// Bins: 60-70, 70-80, 80-90, 90-100
let mut bin1 = 0; // 60-70
let mut bin2 = 0; // 70-80
let mut bin3 = 0; // 80-90
let mut bin4 = 0; // 90-100

for score in test_scores {
    if score >= 60 && score < 70 { bin1 = bin1 + 1; }
    else if score >= 70 && score < 80 { bin2 = bin2 + 1; }
    else if score >= 80 && score < 90 { bin3 = bin3 + 1; }
    else if score >= 90 && score <= 100 { bin4 = bin4 + 1; }
}

println("\n📊 Score distribution:");
println(f"  60-69: {bin1} students {'█' * (bin1 * 2)}");
println(f"  70-79: {bin2} students {'█' * (bin2 * 2)}");
println(f"  80-89: {bin3} students {'█' * (bin3 * 2)}");
println(f"  90-100: {bin4} students {'█' * (bin4 * 2)}");

// Calculate mean bin
let total_students = bin1 + bin2 + bin3 + bin4;
println(f"\nMost common range: 80-89 ({bin3}/{total_students} students)");

// 5. Cumulative Histogram
println("\n5. CUMULATIVE HISTOGRAM:");

let bins = [bin1, bin2, bin3, bin4];
let mut cumulative = [];
let mut cum_sum = 0;

for count in bins {
    cum_sum = cum_sum + count;
    cumulative.push(cum_sum);
}

println("\n📈 Cumulative distribution:");
println(f"  ≤69: {cumulative[0]} ({(cumulative[0] * 100) / total_students}%)");
println(f"  ≤79: {cumulative[1]} ({(cumulative[1] * 100) / total_students}%)");
println(f"  ≤89: {cumulative[2]} ({(cumulative[2] * 100) / total_students}%)");
println(f"  ≤100: {cumulative[3]} ({(cumulative[3] * 100) / total_students}%)");

// 6. Density (normalized histogram)
println("\n6. DENSITY: Normalized Frequencies");

let bin_width = 10;
let density1 = (bin1 as f64) / (total_students as f64 * bin_width as f64);
let density2 = (bin2 as f64) / (total_students as f64 * bin_width as f64);
let density3 = (bin3 as f64) / (total_students as f64 * bin_width as f64);
let density4 = (bin4 as f64) / (total_students as f64 * bin_width as f64);

println(f"\nBin densities (area = 1):");
println(f"  60-69: {density1:.3}");
println(f"  70-79: {density2:.3}");
println(f"  80-89: {density3:.3}");
println(f"  90-100: {density4:.3}");
println("\n✓ Use for: Comparing distributions of different sizes");

println("\n✅ Binning and Histograms Complete!");
println("\n📚 Key concepts:");
println("  • Binning: Group continuous data");
println("  • Equal width: Same bin size");
println("  • Custom edges: Domain-specific bins");
println("  • Frequency: Count per bin");
println("  • Cumulative: Running totals");
println("  • Density: Normalized histogram");
println("\n🎯 Bin selection:");
println("  • Sturges: log₂(n) + 1");
println("  • Square root: √n");
println("  • Too many: Noisy");
println("  • Too few: Oversmoothed");
