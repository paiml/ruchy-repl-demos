// Data Transformation Demo 2: Reduce and Fold - Aggregation Operations
// Concepts: Reduce, fold, accumulation, aggregation
// Use cases: Summing, counting, aggregating, combining data

println("=== Reduce and Fold: Powerful Aggregation ===\n");

// 1. Basic reduce - Sum
println("1. REDUCE: Summing Values");
let numbers = [1, 2, 3, 4, 5];
println(f"Numbers: {numbers:?}");

let mut sum = 0;
for n in numbers {
    sum = sum + n;
}
println(f"Sum: {sum}");

// 2. Reduce - Product
println("\n2. REDUCE: Product");
let values = [2, 3, 4, 5];
let mut product = 1;
for v in values {
    product = product * v;
}
println(f"Values: {values:?}");
println(f"Product: {product}");

// 3. Reduce - Max/Min
println("\n3. REDUCE: Finding Max and Min");
let scores = [85, 92, 78, 95, 88];
let mut max_score = scores[0];
let mut min_score = scores[0];

for score in scores {
    if score > max_score { max_score = score; }
    if score < min_score { min_score = score; }
}
println(f"Scores: {scores:?}");
println(f"Max: {max_score}, Min: {min_score}");

// 4. Reduce - Counting
println("\n4. REDUCE: Counting by Condition");
let grades = [85, 92, 78, 95, 88, 72, 90, 68];
let mut passing = 0;
for grade in grades {
    if grade >= 70 { passing = passing + 1; }
}
println(f"Grades: {grades:?}");
println(f"Passing (≥70): {passing}/{grades.len()}");

// 5. Grouping with reduce
println("\n5. REDUCE: Grouping Data");
let transactions = [
    {category: "food", amount: 50},
    {category: "transport", amount: 30},
    {category: "food", amount: 75},
    {category: "transport", amount: 20},
    {category: "entertainment", amount: 40}
];

let mut totals = {food: 0, transport: 0, entertainment: 0};
for tx in transactions {
    if tx.category == "food" {
        totals.food = totals.food + tx.amount;
    } else if tx.category == "transport" {
        totals.transport = totals.transport + tx.amount;
    } else if tx.category == "entertainment" {
        totals.entertainment = totals.entertainment + tx.amount;
    }
}

println(f"\nCategory totals:");
println(f"  Food: ${totals.food}");
println(f"  Transport: ${totals.transport}");
println(f"  Entertainment: ${totals.entertainment}");

// 6. String concatenation
println("\n6. REDUCE: String Concatenation");
let words = ["Data", "Science", "Is", "Powerful"];
let mut sentence = "";
for i in 0..words.len() {
    sentence = sentence + words[i];
    if i < words.len() - 1 { sentence = sentence + " "; }
}
println(f"Words: {words:?}");
println(f"Sentence: {sentence}");

// 7. Building complex structures
println("\n7. REDUCE: Building Data Structures");
let raw_data = [10, 20, 30, 40, 50];
let mut result = {sum: 0, count: 0, max: 0};

for value in raw_data {
    result.sum = result.sum + value;
    result.count = result.count + 1;
    if value > result.max { result.max = value; }
}
result.average = result.sum / result.count;

println(f"Data: {raw_data:?}");
println(f"Statistics:");
println(f"  Sum: {result.sum}");
println(f"  Count: {result.count}");
println(f"  Average: {result.average}");
println(f"  Max: {result.max}");

println("\n✅ Reduce and Fold Complete!");
println("\n📚 Key Takeaways:");
println("• Reduce: Collapse collection to single value");
println("• Powerful for aggregation and accumulation");
println("• Can build complex derived values");
println("\n🎯 Applications:");
println("  ✓ Summing and aggregating");
println("  ✓ Finding max/min");
println("  ✓ Counting and grouping");
println("  ✓ Building summary statistics");
