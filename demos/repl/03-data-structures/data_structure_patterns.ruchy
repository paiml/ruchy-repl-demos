// Data Structures: Common Patterns
// Verified features: arrays, records, combining structures

println("=== Data Structure Patterns ===\n");

println("1. Key-Value Pattern:");
let config = {
    host: "localhost",
    port: 8080,
    debug: true,
    timeout: 30
};
println(f"Server: {config.host}:{config.port}");
println(f"Debug mode: {config.debug}");

println("\n2. List of Items:");
let items = [
    {id: 1, name: "Apple", price: 1.20},
    {id: 2, name: "Banana", price: 0.80},
    {id: 3, name: "Cherry", price: 3.50}
];
println("Inventory:");
for item in items {
    println(f"  #{item.id}: {item.name} - ${item.price}");
}

println("\n3. Lookup by Index:");
let colors = ["Red", "Green", "Blue", "Yellow"];
let index = 2;
println(f"Color at index {index}: {colors[index]}");

println("\n4. Grouped Data:");
let sales = {
    january: [100, 150, 120],
    february: [110, 140, 135],
    march: [130, 160, 145]
};
println(f"January sales: {sales.january:?}");
println(f"January total: {sales.january.sum()}");

println("\n5. Hierarchical Structure:");
let organization = {
    name: "TechCorp",
    departments: [
        {name: "Engineering", employees: 50},
        {name: "Sales", employees: 30},
        {name: "Support", employees: 20}
    ]
};
println(f"Company: {organization.name}");
println(f"Departments: {organization.departments.len()}");
println(f"First dept: {organization.departments[0].name} ({organization.departments[0].employees} people)");

println("\n✅ Data Structure Patterns Complete!");
